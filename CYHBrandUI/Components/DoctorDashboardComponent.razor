@using CYHBrandModel.DTO
@inject NavigationManager Navigation

<div class="doctor-dashboard-blazor">
    <!-- ── Shiny Hero Banner ── -->
    <div class="hero-shiny-banner p-4 p-md-5 mb-4 text-white">
        <div class="row align-items-center position-relative" style="z-index: 2;">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <span class="badge rounded-pill bg-teal bg-opacity-25 text-white border border-light border-opacity-25 px-3 py-1 small">
                        <i class="bi bi-patch-check-fill text-warning me-1"></i> Medical Branding Workspace
                    </span>
                    <span class="badge rounded-pill bg-white bg-opacity-10 text-white px-2 py-1 small">
                        <i class="bi bi-clock-history me-1"></i> @DateTime.Now.ToString("dddd, dd MMMM yyyy")
                    </span>
                </div>
                <h2 class="fw-bold mb-2 display-6 text-white">
                    @Greeting, <span class="gradient-text-shiny">Dr. @DoctorName</span> 👋
                </h2>
                <p class="mb-3 text-white-50 lead fs-6" style="max-width: 620px;">
                    Boost your clinic's patient outreach with clinically verified banner designs, AI awareness posts, and scheduled social health updates.
                </p>
                <div class="d-flex flex-wrap gap-2 pt-1">
                    <a href="/AiBanner" class="btn btn-shiny rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-2">
                        <i class="bi bi-stars"></i> Create with AI
                    </a>
                    <a href="/Template" class="btn btn-outline-light rounded-pill px-4 py-2 d-inline-flex align-items-center gap-2">
                        <i class="bi bi-grid-1x2"></i> Browse Templates
                    </a>
                </div>
            </div>
            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0 d-none d-lg-block">
                <div class="p-3 rounded-4 glass-card d-inline-block text-start" style="background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.25);">
                    <div class="small text-white-50 text-uppercase fw-bold" style="letter-spacing:0.5px;">Branding Status</div>
                    <div class="fs-5 fw-bold text-white mt-1 d-flex align-items-center gap-2">
                        <span class="badge bg-success rounded-circle p-1" style="width:10px;height:10px;display:inline-block;"></span> Active Verified
                    </div>
                    <div class="text-white-50 small mt-2">
                        <i class="bi bi-shield-check text-teal me-1"></i> High-resolution exports unlocked
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Interactive AI Topic Inspirations ── -->
    <div class="shiny-card p-3 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-circle p-2 bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-lightbulb-fill"></i>
                </span>
                <span class="fw-bold text-dark small text-uppercase" style="letter-spacing:0.5px;">Today's AI Post Inspirations</span>
            </div>
            <span class="text-muted small">Click any topic to quick-launch</span>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @foreach (var topic in TrendingTopics)
            {
                var isSelected = SelectedTopic == topic;
                <button type="button" 
                        class="btn btn-sm rounded-pill px-3 py-1 @(isSelected ? "btn-primary shadow-sm" : "btn-light border text-secondary")"
                        @onclick="() => SelectTopic(topic)">
                    <i class="bi bi-tag-fill me-1 @(isSelected ? "text-warning" : "text-teal")"></i>@topic
                </button>
            }
        </div>
        @if (!string.IsNullOrEmpty(SelectedTopic))
        {
            <div class="mt-3 p-3 rounded-3 bg-light border d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-magic text-teal fs-5"></i>
                    <div>
                        <strong class="text-dark">Ready to generate:</strong>
                        <span class="text-secondary ms-1">"@SelectedTopic" banner for your patients</span>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a href="/AiBanner?topic=@Uri.EscapeDataString(SelectedTopic)" class="btn btn-shiny btn-sm rounded-pill px-3">
                        <i class="bi bi-stars me-1"></i> Launch in AI Maker
                    </a>
                    <a href="/Template?searchKey=@Uri.EscapeDataString(SelectedTopic)" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        <i class="bi bi-search me-1"></i> Find in Templates
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- ── Shiny Stat Cards ── -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="shiny-card p-3 h-100 d-flex align-items-center gap-3">
                <div class="rounded-4 p-3 d-flex align-items-center justify-content-center" style="background:#EFF6FF; width:52px; height:52px;">
                    <i class="bi bi-grid-fill" style="color:#3B82F6; font-size:1.5rem;"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold text-dark">@(Model?.TotalDesigns ?? 0)</div>
                    <div class="text-muted small fw-medium">Total Designs</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="shiny-card p-3 h-100 d-flex align-items-center gap-3">
                <div class="rounded-4 p-3 d-flex align-items-center justify-content-center" style="background:#F0FDF4; width:52px; height:52px;">
                    <i class="bi bi-calendar-check-fill" style="color:#10B981; font-size:1.5rem;"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold text-dark">@(Model?.ScheduledPosts ?? 0)</div>
                    <div class="text-muted small fw-medium">Scheduled Posts</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="shiny-card p-3 h-100 d-flex align-items-center gap-3">
                <div class="rounded-4 p-3 d-flex align-items-center justify-content-center" style="background:#FFF7ED; width:52px; height:52px;">
                    <i class="bi bi-share-fill" style="color:#F59E0B; font-size:1.5rem;"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold text-dark">@(Model?.TotalShares ?? 0)</div>
                    <div class="text-muted small fw-medium">Total Shares</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="shiny-card p-3 h-100 d-flex align-items-center gap-3">
                <div class="rounded-4 p-3 d-flex align-items-center justify-content-center" style="background:rgba(14,165,160,.12); width:52px; height:52px;">
                    <i class="bi bi-people-fill" style="color:#0EA5A0; font-size:1.5rem;"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold text-dark">
                        @(Model?.SocialReach > 0 ? (Model.SocialReach >= 1000 ? $"{Model.SocialReach/1000.0:0.#}K" : Model.SocialReach.ToString()) : "0")
                    </div>
                    <div class="text-muted small fw-medium">Estimated Reach</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Interactive Recent Designs Section ── -->
    <div class="shiny-card mb-4">
        <div class="p-4 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h5 class="fw-bold mb-1 text-dark">Recent Designs &amp; Creatives</h5>
                <p class="text-muted small mb-0">Manage, edit, or preview your customized medical banners</p>
            </div>
            
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <!-- Search Filter -->
                <div class="input-group input-group-sm" style="width: 220px;">
                    <span class="input-group-text bg-light border-end-0 rounded-start-pill text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" class="form-control bg-light border-start-0 rounded-end-pill shadow-none" 
                           placeholder="Filter designs..." 
                           @bind="SearchText" @bind:event="oninput" />
                </div>

                <!-- Status Filter Pills -->
                <div class="btn-group btn-group-sm p-1 bg-light rounded-pill border">
                    <button type="button" class="btn rounded-pill px-3 @(ActiveTab == "All" ? "btn-primary text-white shadow-sm" : "btn-light text-muted")"
                            @onclick='() => SetTab("All")'>All</button>
                    <button type="button" class="btn rounded-pill px-3 @(ActiveTab == "Published" ? "btn-primary text-white shadow-sm" : "btn-light text-muted")"
                            @onclick='() => SetTab("Published")'>Published</button>
                    <button type="button" class="btn rounded-pill px-3 @(ActiveTab == "Draft" ? "btn-primary text-white shadow-sm" : "btn-light text-muted")"
                            @onclick='() => SetTab("Draft")'>Drafts</button>
                </div>

                <a href="/Design/Create" class="btn btn-shiny btn-sm rounded-pill px-3">
                    <i class="bi bi-plus-lg me-1"></i> New Banner
                </a>
            </div>
        </div>

        <div class="p-4">
            @if (FilteredDesigns?.Any() == true)
            {
                <div class="row g-3">
                    @foreach (var d in FilteredDesigns)
                    {
                        var thumb = !string.IsNullOrWhiteSpace(d.ThumbnailPath)
                            ? (d.ThumbnailPath.StartsWith("data:") || d.ThumbnailPath.StartsWith("http") ? d.ThumbnailPath : "/" + d.ThumbnailPath.TrimStart('/'))
                            : "";
                        <div class="col-sm-6 col-lg-3">
                            <div class="card h-100 border rounded-4 overflow-hidden shadow-sm" style="transition: transform 0.2s, box-shadow 0.2s;">
                                <div class="position-relative bg-dark d-flex align-items-center justify-content-center" style="aspect-ratio: 1/1; overflow:hidden;">
                                    @if (!string.IsNullOrEmpty(thumb))
                                    {
                                        <img src="@thumb" alt="@d.DesignName" style="width:100%; height:100%; object-fit:contain;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-image text-white-50" style="font-size:2.5rem;"></i>
                                    }
                                    <span class="position-absolute top-0 end-0 m-2 badge @(d.StatusId == 2 ? "bg-success" : "bg-secondary") rounded-pill px-2 py-1" style="font-size:10px;">
                                        @(d.StatusId == 2 ? "Published" : "Draft")
                                    </span>
                                </div>
                                <div class="card-body p-3 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="fw-bold text-dark text-truncate mb-1" title="@d.DesignName">@d.DesignName</div>
                                        <div class="text-muted small mb-3">
                                            <i class="bi bi-calendar3 me-1"></i>@d.CreatedAt.ToString("dd MMM yyyy")
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2 pt-2 border-top">
                                        <a href="/Design/Edit/@d.DesignId" class="btn btn-sm btn-outline-primary rounded-pill flex-fill">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </a>
                                        <a href="/Design/Detail/@d.DesignId" class="btn btn-sm btn-outline-secondary rounded-pill flex-fill">
                                            <i class="bi bi-eye me-1"></i>View
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width:70px; height:70px;">
                        <i class="bi bi-images text-muted fs-2"></i>
                    </div>
                    <h6 class="fw-bold text-dark">No designs matching your filter</h6>
                    <p class="text-muted small mb-3">Create your first customized clinical banner or pick a template.</p>
                    <a href="/Design/Create" class="btn btn-shiny btn-sm rounded-pill px-4">
                        <i class="bi bi-plus-lg me-1"></i> Create Design Now
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public DashboardDTO Model { get; set; } = new DashboardDTO();

    [Parameter]
    public string DoctorName { get; set; } = "Doctor";

    private string Greeting { get; set; } = "Good Day";
    private string SearchText { get; set; } = "";
    private string ActiveTab { get; set; } = "All";
    private string SelectedTopic { get; set; } = "";

    private readonly List<string> TrendingTopics = new()
    {
        "Seasonal Flu Prevention",
        "World Heart Day Alert",
        "Diabetes Diet Tips",
        "Free Health Screening Camp",
        "Hypertension Checkup",
        "Pediatric Care Tips"
    };

    protected override void OnInitialized()
    {
        var hour = DateTime.Now.Hour;
        Greeting = hour < 12 ? "Good Morning" : hour < 17 ? "Good Afternoon" : "Good Evening";
    }

    private void SelectTopic(string topic)
    {
        if (SelectedTopic == topic)
        {
            SelectedTopic = "";
        }
        else
        {
            SelectedTopic = topic;
        }
    }

    private void SetTab(string tab)
    {
        ActiveTab = tab;
    }

    private IEnumerable<BannerDesignDTO> FilteredDesigns
    {
        get
        {
            var designs = Model?.RecentDesigns ?? new List<BannerDesignDTO>();

            if (ActiveTab == "Published")
            {
                designs = designs.Where(d => d.StatusId == 2).ToList();
            }
            else if (ActiveTab == "Draft")
            {
                designs = designs.Where(d => d.StatusId != 2).ToList();
            }

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                designs = designs.Where(d =>
                    (d.DesignName != null && d.DesignName.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ||
                    (d.CategoryName != null && d.CategoryName.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
                ).ToList();
            }

            return designs;
        }
    }
}
