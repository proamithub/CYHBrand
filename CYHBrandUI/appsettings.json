{
  "ConnectionStrings": {
    "DefaultConnection": "Server=VRS-AMITPC\\SQLEXPRESS;Database=CYHBrandDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AIImageGeneration": {
    "Provider": "Stub",
    "OpenAI": {
      "ApiKey": "",
      "Model": "dall-e-3",
      "TimeoutSeconds": 60
    },
    "AzureOpenAI": {
      "Endpoint": "",
      "ApiKey": "",
      "DeploymentName": ""
    }
  },
  "Storage": {
    "Provider": "LocalDisk",
    "LocalDisk": {
      "BasePath": "uploads"
    },
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "cyhbrand-assets"
    }
  },
  "Email": {
    "SmtpHost": "localhost",
    "SmtpPort": 587,
    "UseSsl": false,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@cyhbrand.com",
    "FromName": "CYHBrand"
  },
  "Social": {
    "Facebook": { "AppId": "", "AppSecret": "" },
    "Instagram": { "AppId": "", "AppSecret": "" },
    "LinkedIn": { "ClientId": "", "ClientSecret": "" },
    "Twitter": { "ClientId": "", "ClientSecret": "" }
  },
  "RateLimiting": {
    "Login": { "PermitLimit": 5, "WindowSeconds": 900 }
  },
  "DataProtection": {
    "ApplicationName": "CYHBrand"
  },
  "Features": {
    "SocialPublishing": false,
    "AIBannerCreation": true,
    "PremiumTemplates": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cyhbrand-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
