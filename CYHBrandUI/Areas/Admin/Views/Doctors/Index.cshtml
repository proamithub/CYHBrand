@model CYHBrandModel.Common.PagedResult<CYHBrandModel.DTO.DoctorMasterDTO>
@{
    ViewData["Title"] = "Doctors Directory";
    var searchKey = ViewBag.SearchKey as string ?? "";
}

<div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
    <div class="card-body p-3 p-md-4">
        <!-- Header & Search Toolbar -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h5 class="fw-bold text-dark mb-1">Practitioner Management</h5>
                <p class="text-muted small mb-0">Total @(Model?.TotalRecord ?? 0) verified medical professionals registered on CYHBrand</p>
            </div>

            <!-- Search Form -->
            <form method="get" asp-action="Index" class="d-flex gap-2">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 ps-3 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchKey" value="@searchKey" class="form-control bg-light border-start-0 py-2 shadow-none" placeholder="Search doctor, clinic, email..." />
                    @if (!string.IsNullOrEmpty(searchKey))
                    {
                        <a href="/Admin/Doctors" class="btn btn-light border" title="Clear"><i class="bi bi-x"></i></a>
                    }
                    <button type="submit" class="btn btn-primary px-3">Search</button>
                </div>
            </form>
        </div>

        @Html.AntiForgeryToken()

        <!-- Alert Container -->
        <div id="doctorActionAlert" class="alert d-none rounded-3 py-2 mb-3 small"></div>

        <!-- Doctors Table -->
        @if (Model?.Items?.Any() == true)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th>Doctor ID</th>
                            <th>Doctor Profile</th>
                            <th>Specialty &amp; Clinic</th>
                            <th>Contact Details</th>
                            <th>AI Credits</th>
                            <th>Account Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Items)
                        {
                            <tr>
                                <td class="font-monospace small text-muted">#DOC-@d.DoctorId</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(d.ProfilePic))
                                        {
                                            <img src="@d.ProfilePic" alt="@d.FullName" class="rounded-circle shadow-sm" style="width: 38px; height: 38px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-size: 13px;">
                                                DR
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold text-dark">@(d.DisplayName ?? d.FullName)</div>
                                            <small class="text-muted" style="font-size: 11px;">Registered: @(d.CreatedDate?.ToString("dd MMM yyyy") ?? "-")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small fw-semibold text-dark">@(d.Specialty ?? "General Practice")</div>
                                    <small class="text-muted">@(d.ClinicName ?? "Private Clinic")</small>
                                </td>
                                <td>
                                    <div class="small"><i class="bi bi-envelope me-1 text-muted"></i>@d.Email</div>
                                    <div class="small text-muted"><i class="bi bi-phone me-1 text-muted"></i>@d.MobileNo</div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-2 py-1">
                                            <i class="bi bi-coin text-warning me-1"></i><span id="creditVal-@d.DoctorId">@d.AiCredits</span>
                                        </span>
                                        <button type="button" class="btn btn-outline-secondary btn-sm p-1 rounded-circle" 
                                                title="Add AI Credits"
                                                onclick="openCreditModal(@d.DoctorId, '@(d.DisplayName ?? d.FullName)')">
                                            <i class="bi bi-plus-circle-fill text-primary" style="font-size: 13px;"></i>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input cursor-pointer" type="checkbox" role="switch" 
                                               id="statusSwitch-@d.DoctorId" 
                                               checked="@d.IsActive"
                                               onchange="toggleDoctorStatus(@d.DoctorId, this.checked)" />
                                        <label class="form-check-label small" for="statusSwitch-@d.DoctorId" id="statusLabel-@d.DoctorId">
                                            @(d.IsActive ? "Active" : "Disabled")
                                        </label>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-light btn-sm border rounded-pill px-3" 
                                            onclick="openCreditModal(@d.DoctorId, '@(d.DisplayName ?? d.FullName)')">
                                        <i class="bi bi-coin text-warning me-1"></i> Add Credits
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-center mt-4">
                    <nav>
                        <ul class="pagination pagination-sm gap-1 mb-0">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageNo ? "active" : "")">
                                    <a class="page-link rounded-pill px-3" href="/Admin/Doctors?pageNo=@i&searchKey=@searchKey">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-people text-muted fs-1 mb-2"></i>
                <h6 class="text-dark fw-bold">No Doctors Found</h6>
                <p class="text-muted small">No practitioner accounts matched your search keyword.</p>
                <a href="/Admin/Doctors" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Reset Search</a>
            </div>
        }
    </div>
</div>

<!-- ── ALLOCATE CREDITS MODAL ── -->
<div class="modal fade" id="addCreditModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom px-4 py-3 bg-light">
                <h6 class="modal-title fw-bold text-dark mb-0">Allocate AI Credits</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="small text-muted mb-3">Adding credits to <strong id="modalDoctorName" class="text-dark">Doctor</strong></p>
                <input type="hidden" id="modalDoctorId" />
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted">Amount of Credits</label>
                    <input type="number" id="modalCreditAmount" class="form-control rounded-pill text-center fs-5 fw-bold" value="50" min="5" step="5" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted">Allocation Reason</label>
                    <input type="text" id="modalCreditReason" class="form-control rounded-pill small" placeholder="e.g. Monthly Top-up / Support Bonus" value="Admin Bonus Top-up" />
                </div>
                <button type="button" class="btn btn-primary rounded-pill w-100 py-2 fw-semibold" onclick="submitCredits()">
                    Confirm &amp; Add Credits
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    function openCreditModal(docId, docName) {
        document.getElementById('modalDoctorId').value = docId;
        document.getElementById('modalDoctorName').textContent = docName;
        const modal = new bootstrap.Modal(document.getElementById('addCreditModal'));
        modal.show();
    }

    async function toggleDoctorStatus(docId, isActive) {
        const token = getAntiForgeryToken();
        const formData = new FormData();
        formData.append('doctorId', docId);
        formData.append('isActive', isActive);
        formData.append('__RequestVerificationToken', token);

        try {
            const resp = await fetch('/Admin/Doctors/ToggleStatus', {
                method: 'POST',
                body: formData
            });
            const data = await resp.json();
            const label = document.getElementById('statusLabel-' + docId);
            if (data.success) {
                label.textContent = isActive ? 'Active' : 'Disabled';
            } else {
                alert(data.message || 'Status update failed');
                document.getElementById('statusSwitch-' + docId).checked = !isActive;
            }
        } catch (err) {
            alert('Request failed');
            document.getElementById('statusSwitch-' + docId).checked = !isActive;
        }
    }

    async function submitCredits() {
        const docId = document.getElementById('modalDoctorId').value;
        const credits = parseInt(document.getElementById('modalCreditAmount').value);
        const reason = document.getElementById('modalCreditReason').value;
        const token = getAntiForgeryToken();

        if (isNaN(credits) || credits <= 0) {
            alert('Please enter a valid credit amount.');
            return;
        }

        const formData = new FormData();
        formData.append('doctorId', docId);
        formData.append('credits', credits);
        formData.append('reason', reason);
        formData.append('__RequestVerificationToken', token);

        try {
            const resp = await fetch('/Admin/Doctors/AddCredits', {
                method: 'POST',
                body: formData
            });
            const data = await resp.json();
            if (data.success) {
                const badge = document.getElementById('creditVal-' + docId);
                if (badge) {
                    badge.textContent = parseInt(badge.textContent || '0') + credits;
                }
                bootstrap.Modal.getInstance(document.getElementById('addCreditModal')).hide();
                alert(data.message || 'Credits added!');
            } else {
                alert(data.message || 'Failed to add credits.');
            }
        } catch (err) {
            alert('Request failed.');
        }
    }
</script>
}
