@model CYHBrandModel.DTO.DoctorMasterDTO
@{
    ViewData["Title"] = "Edit Profile & Branding";
    var primaryColor = !string.IsNullOrWhiteSpace(Model?.PrimaryColorHex) ? Model.PrimaryColorHex : "#1B2B6B";
    var secondaryColor = !string.IsNullOrWhiteSpace(Model?.SecondaryColorHex) ? Model.SecondaryColorHex : "#0EA5A0";
    var preferredFont = !string.IsNullOrWhiteSpace(Model?.PreferredFont) ? Model.PreferredFont : "Inter";
    var initials = !string.IsNullOrWhiteSpace(Model?.FullName)
        ? (Model.FullName.Length >= 2 ? Model.FullName.Substring(0, 2).ToUpper() : Model.FullName.Substring(0, 1).ToUpper())
        : "DR";
}

<div class="container-fluid px-3 px-md-4 py-3">

    <!-- ── TOP HEADER & BREADCRUMB ── -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Doctor" asp-action="Profile" class="text-decoration-none text-muted">My Profile</a></li>
                    <li class="breadcrumb-item active text-primary fw-medium" aria-current="page">Edit Profile & Branding</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-person-badge-fill text-primary"></i> Doctor Profile & Branding Studio
            </h3>
            <p class="text-muted small mb-0 mt-1">Configure your clinical identity, contact details, and automated AI banner branding footer.</p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- AI Credits Pill -->
            <div class="badge bg-warning-subtle text-dark border border-warning px-3 py-2 rounded-pill fs-7 d-flex align-items-center gap-2" title="Available AI Generation Credits">
                <i class="bi bi-lightning-charge-fill text-warning"></i>
                <span>Credits: <strong id="headerCreditsCount">@(Model?.AiCredits ?? 10)</strong></span>
            </div>

            <a asp-action="Profile" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-eye me-1"></i> View Profile
            </a>

            <a asp-controller="AiBanner" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="bi bi-stars me-1"></i> AI Banner Studio
            </a>

            <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm" onclick="submitMainProfileForm()">
                <i class="bi bi-check2-circle me-1"></i> Save Changes
            </button>
        </div>
    </div>

    <!-- ── FEEDBACK ALERTS ── -->
    @if (TempData["SuccessMsg"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
            <div>@TempData["SuccessMsg"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMsg"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
            <div>@TempData["ErrorMsg"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div id="ajaxToastMsg" class="alert alert-info alert-dismissible fade d-none shadow-sm border-0 rounded-3 mb-4 align-items-center" role="alert">
        <i class="bi bi-info-circle-fill fs-5 me-2" id="ajaxToastIcon"></i>
        <div id="ajaxToastText"></div>
        <button type="button" class="btn-close ms-auto" onclick="hideToast()"></button>
    </div>

    <!-- ── MAIN 2-COLUMN WORKSPACE ── -->
    <div class="row g-4">

        <!-- ══════════════════════════════════════════════════
             LEFT COLUMN (col-lg-4):
             1. Doctor Identity Preview & Avatar Upload
             2. Live AI Banner Branding Footer Ribbon Mockup
             3. Clinic Logo Quick Manager
             ══════════════════════════════════════════════════ -->
        <div class="col-xl-4 col-lg-5">

            <!-- Card 1: Doctor Identity & Avatar -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 position-relative">
                <div class="p-3 text-white text-center position-relative" style="background: linear-gradient(135deg, @primaryColor 0%, #0F1A42 100%);">
                    <span class="badge bg-white text-primary position-absolute top-0 end-0 m-3 px-2 py-1 rounded-pill small fw-semibold">
                        <i class="bi bi-patch-check-fill text-primary me-1"></i> Verified Doctor
                    </span>

                    <!-- Doctor Avatar with Overlay Upload -->
                    <div class="position-relative d-inline-block mt-2 mb-2">
                        <div id="avatarContainer" class="rounded-circle shadow border border-3 border-white overflow-hidden bg-white d-inline-flex align-items-center justify-content-center"
                             style="width: 110px; height: 110px; cursor: pointer;" onclick="document.getElementById('profilePicFileInput').click()" title="Click to upload/change photo">
                            @if (!string.IsNullOrEmpty(Model?.ProfilePic))
                            {
                                <img id="liveAvatarImg" src="@Model.ProfilePic" alt="@Model.FullName" class="w-100 h-100" style="object-fit:cover;" />
                            }
                            else
                            {
                                <div id="liveAvatarPlaceholder" class="w-100 h-100 d-flex align-items-center justify-content-center text-white fw-bold fs-2"
                                     style="background: linear-gradient(135deg, @primaryColor, @secondaryColor);">
                                    @initials
                                </div>
                            }
                        </div>
                        <label for="profilePicFileInput" class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow"
                               style="width: 34px; height: 34px; cursor: pointer; border: 2px solid #fff;" title="Upload new photo">
                            <i class="bi bi-camera-fill small"></i>
                        </label>
                        <input type="file" id="profilePicFileInput" accept=".jpg,.jpeg,.png" hidden onchange="uploadDoctorAvatar(this)" />
                    </div>

                    <h5 class="fw-bold mb-1 text-white" id="liveDoctorName">
                        @(string.IsNullOrWhiteSpace(Model?.FullName) ? "Dr. Full Name" : (Model.FullName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ? Model.FullName : "Dr. " + Model.FullName))
                    </h5>
                    <div class="badge bg-light text-primary fw-medium px-3 py-1 rounded-pill small mb-2" id="liveSpecialtyBadge">
                        @(string.IsNullOrWhiteSpace(Model?.Specialty) ? "Medical Specialist" : Model.Specialty)
                    </div>
                    <div class="small text-white-50" id="liveClinicSub">
                        <i class="bi bi-geo-alt-fill me-1 text-warning"></i>
                        <span id="liveClinicNameTxt">@(string.IsNullOrWhiteSpace(Model?.ClinicName) ? "Clinic Name" : Model.ClinicName)</span>
                        <span id="liveCityTxt">@(string.IsNullOrWhiteSpace(Model?.City) ? "" : $", {Model.City}")</span>
                    </div>
                </div>

                <div class="card-body p-3 bg-white">
                    <!-- Profile Completeness Meter -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center small mb-1">
                            <span class="text-muted fw-semibold">Profile Completeness</span>
                            <span class="fw-bold text-primary" id="completionPercent">80%</span>
                        </div>
                        <div class="progress" style="height: 6px; border-radius: 4px;">
                            <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" id="completionBar" role="progressbar" style="width: 80%"></div>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mt-2 pt-1 border-top" style="font-size: 11px;">
                            <span id="chkName"><i class="bi bi-check-circle-fill text-success"></i> Name</span>
                            <span id="chkSpec"><i class="bi bi-check-circle-fill text-success"></i> Specialty</span>
                            <span id="chkClinic"><i class="bi bi-check-circle-fill text-success"></i> Clinic</span>
                            <span id="chkPhoto"><i class="bi bi-check-circle-fill text-success"></i> Photo</span>
                            <span id="chkBrand"><i class="bi bi-check-circle-fill text-success"></i> Brand</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" onclick="document.getElementById('profilePicFileInput').click()">
                            <i class="bi bi-camera me-1"></i> Update Profile Picture
                        </button>
                    </div>
                    <div id="avatarUploadStatus" class="small text-center mt-2"></div>
                </div>
            </div>

            <!-- Card 2: Interactive Real-Time AI Banner Footer Ribbon Mockup -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white border-0 pt-3 px-3 pb-2 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-columns-gap text-teal"></i> Live Banner Branding Footer
                        </h6>
                        <small class="text-muted" style="font-size: 11px;">Automatic footer embedded on generated AI banners</small>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill" style="font-size: 10px;">
                        <i class="bi bi-broadcast me-1"></i> Live Sync
                    </span>
                </div>
                <div class="card-body p-3 pt-0">
                    <p class="text-muted small mb-2" style="font-size: 12px;">
                        This dynamic footer will be rendered at the bottom of your banners when <em>"Embed Doctor Branding"</em> is turned on.
                    </p>

                    <!-- LIVE FOOTER CONTAINER -->
                    <div id="mockupFooterBox" class="rounded-3 shadow-sm text-white overflow-hidden p-3 position-relative"
                         style="background: @primaryColor; font-family: '@preferredFont', sans-serif; transition: all 0.3s ease;">
                        
                        <!-- Top Accent Line -->
                        <div id="mockupAccentLine" class="position-absolute top-0 start-0 w-100" style="height: 4px; background: @secondaryColor;"></div>

                        <div class="d-flex align-items-center gap-3">
                            <!-- Avatar in Footer -->
                            <div class="flex-shrink-0">
                                <div id="mockupAvatarWrap" class="rounded-circle overflow-hidden shadow-sm d-flex align-items-center justify-content-center"
                                     style="width: 52px; height: 52px; border: 2px solid @secondaryColor; background: rgba(255,255,255,0.2);">
                                    @if (!string.IsNullOrEmpty(Model?.ProfilePic))
                                    {
                                        <img id="mockupAvatarImg" src="@Model.ProfilePic" alt="Doctor" class="w-100 h-100" style="object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span id="mockupAvatarInitial" class="fw-bold text-white small">@initials</span>
                                    }
                                </div>
                            </div>

                            <!-- Doctor Name & Credentials -->
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="fw-bold text-truncate" id="mockupDocName" style="font-size: 14px; letter-spacing: 0.3px;">
                                    @(string.IsNullOrWhiteSpace(Model?.FullName) ? "Dr. Full Name" : (Model.FullName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ? Model.FullName : "Dr. " + Model.FullName))
                                </div>
                                <div class="small text-truncate" id="mockupDocQual" style="font-size: 11px; color: @secondaryColor;">
                                    @(string.IsNullOrWhiteSpace(Model?.Qualifications) ? "MBBS, MD" : Model.Qualifications) • <span id="mockupDocSpec">@(string.IsNullOrWhiteSpace(Model?.Specialty) ? "Specialist" : Model.Specialty)</span>
                                </div>
                                <div class="small text-truncate text-white-50" id="mockupClinicLine" style="font-size: 10px;">
                                    <i class="bi bi-hospital me-1"></i><span id="mockupClinicName">@(string.IsNullOrWhiteSpace(Model?.ClinicName) ? "Clinic / Hospital Name" : Model.ClinicName)</span>
                                </div>
                            </div>
                        </div>

                        <!-- Footer Bottom Bar: Phone & Address -->
                        <div class="mt-2 pt-2 border-top border-white-50 d-flex flex-wrap align-items-center justify-content-between gap-1" style="font-size: 10px;">
                            <div id="mockupPhone" class="d-flex align-items-center gap-1 text-truncate">
                                <i class="bi bi-telephone-fill" style="color: @secondaryColor;"></i>
                                <span id="mockupPhoneTxt">@(string.IsNullOrWhiteSpace(Model?.MobileNo) ? "+91 98765 43210" : Model.MobileNo)</span>
                            </div>
                            <div id="mockupLocation" class="text-white-50 text-truncate">
                                <i class="bi bi-geo-alt-fill me-1"></i>
                                <span id="mockupAddressTxt">@(string.IsNullOrWhiteSpace(Model?.City) ? "City, State" : $"{Model.City}{(string.IsNullOrWhiteSpace(Model?.PinCode) ? "" : " - " + Model.PinCode)}")</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mt-2 pt-1 text-muted" style="font-size: 11px;">
                        <span><i class="bi bi-palette me-1"></i> Colors: <strong id="lblPrimaryHex">@primaryColor</strong> / <strong id="lblSecondaryHex">@secondaryColor</strong></span>
                        <span><i class="bi bi-type me-1"></i> Font: <strong id="lblFontName">@preferredFont</strong></span>
                    </div>
                </div>
            </div>

            <!-- Card 3: Clinic Logo Manager -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white border-0 pt-3 px-3 pb-2">
                    <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-hospital text-primary"></i> Clinic / Hospital Logo
                    </h6>
                    <small class="text-muted" style="font-size: 11px;">Appears on digital prescriptions and banner corners</small>
                </div>
                <div class="card-body p-3 pt-0 text-center">
                    <div class="p-3 mb-2 rounded-3 border bg-light d-flex align-items-center justify-content-center" style="min-height: 90px;">
                        @if (!string.IsNullOrEmpty(Model?.ClinicLogo))
                        {
                            <img id="clinicLogoPreviewImg" src="@Model.ClinicLogo" alt="Clinic Logo" style="max-height: 70px; max-width: 100%; object-fit: contain;" />
                        }
                        else
                        {
                            <div id="clinicLogoPlaceholder" class="text-muted small d-flex flex-column align-items-center">
                                <i class="bi bi-building fs-3 text-secondary mb-1"></i>
                                <span>No logo uploaded yet</span>
                            </div>
                            <img id="clinicLogoPreviewImg" src="" alt="Clinic Logo" class="d-none" style="max-height: 70px; max-width: 100%; object-fit: contain;" />
                        }
                    </div>

                    <label class="btn btn-outline-secondary btn-sm rounded-pill w-100">
                        <i class="bi bi-upload me-1"></i> Upload Clinic Logo
                        <input type="file" id="clinicLogoFileInput" accept=".jpg,.jpeg,.png,.svg" hidden onchange="uploadClinicLogo(this)" />
                    </label>
                    <div id="logoUploadStatus" class="small mt-1"></div>
                    <small class="text-muted d-block mt-1" style="font-size: 11px;">Recommended: Transparent PNG, max 5 MB</small>
                </div>
            </div>

        </div>

        <!-- ══════════════════════════════════════════════════
             RIGHT COLUMN (col-lg-8):
             Multi-Tab Unified Settings Form
             Tab 1: 👤 Personal Info
             Tab 2: 🏥 Clinic Details
             Tab 3: 🎨 Brand Styling & Palette
             Tab 4: 📸 Media & Assets
             Tab 5: ⚡ AI Credits & Account
             ══════════════════════════════════════════════════ -->
        <div class="col-xl-8 col-lg-7">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <!-- Nav Tabs Navigation -->
                <div class="card-header bg-white border-bottom px-3 pt-3 pb-0">
                    <ul class="nav nav-pills card-header-pills gap-1" id="editProfileTabList" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active rounded-pill px-3 py-2 fw-medium small" id="tab-personal-btn" data-bs-toggle="pill" data-bs-target="#tab-personal" type="button" role="tab">
                                <i class="bi bi-person me-1"></i> Personal Info
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill px-3 py-2 fw-medium small" id="tab-clinic-btn" data-bs-toggle="pill" data-bs-target="#tab-clinic" type="button" role="tab">
                                <i class="bi bi-hospital me-1"></i> Clinic Details
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill px-3 py-2 fw-medium small" id="tab-brand-btn" data-bs-toggle="pill" data-bs-target="#tab-brand" type="button" role="tab">
                                <i class="bi bi-palette me-1"></i> Brand & Colors
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill px-3 py-2 fw-medium small" id="tab-photos-btn" data-bs-toggle="pill" data-bs-target="#tab-photos" type="button" role="tab">
                                <i class="bi bi-images me-1"></i> Photos & Assets
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill px-3 py-2 fw-medium small" id="tab-credits-btn" data-bs-toggle="pill" data-bs-target="#tab-credits" type="button" role="tab">
                                <i class="bi bi-lightning-charge me-1"></i> AI Credits
                            </button>
                        </li>
                    </ul>
                </div>

                <!-- UNIFIED MAIN FORM -->
                <form asp-action="EditProfile" asp-controller="Doctor" method="post" id="profileForm" class="needs-validation">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="DoctorId" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="AiCredits" />

                    <div class="card-body p-4">
                        <div class="tab-content" id="editProfileTabContent">

                            <!-- ── TAB 1: PERSONAL INFORMATION ── -->
                            <div class="tab-pane fade show active" id="tab-personal" role="tabpanel">
                                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                    <div>
                                        <h5 class="fw-bold mb-0 text-dark">Personal Information</h5>
                                        <small class="text-muted">Doctor's full medical credentials, title, and contact methods.</small>
                                    </div>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill small">Step 1 of 4</span>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="FullName" class="form-label fw-semibold text-dark small">Full Name <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="bi bi-person-fill"></i></span>
                                            <input asp-for="FullName" id="inputFullName" class="form-control" placeholder="e.g. Dr. Rajesh Sharma" required oninput="syncLivePreview()" />
                                        </div>
                                        <span asp-validation-for="FullName" class="text-danger small"></span>
                                        <small class="text-muted" style="font-size: 11px;">Include your professional prefix ("Dr.").</small>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="DisplayName" class="form-label fw-semibold text-dark small">Display / Banner Name</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="bi bi-tag-fill"></i></span>
                                            <input asp-for="DisplayName" id="inputDisplayName" class="form-control" placeholder="e.g. Dr. Rajesh" oninput="syncLivePreview()" />
                                        </div>
                                        <small class="text-muted" style="font-size: 11px;">Short name used for casual greetings or social posts.</small>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold text-dark small">Email Address</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope-fill"></i></span>
                                            <input type="email" value="@Model?.Email" class="form-control bg-light" disabled readonly />
                                            <span class="input-group-text bg-light text-success"><i class="bi bi-shield-check" title="Verified Account Email"></i></span>
                                        </div>
                                        <small class="text-muted" style="font-size: 11px;">Primary login email cannot be changed from this screen.</small>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="MobileNo" class="form-label fw-semibold text-dark small">Mobile / WhatsApp Number</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone-fill"></i></span>
                                            <input asp-for="MobileNo" id="inputMobileNo" class="form-control" placeholder="+91 9876543210" oninput="syncLivePreview()" />
                                        </div>
                                        <small class="text-muted" style="font-size: 11px;">Direct contact displayed on banner footers.</small>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="Specialty" class="form-label fw-semibold text-dark small">Medical Specialty</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="bi bi-heart-pulse-fill"></i></span>
                                            <input asp-for="Specialty" id="inputSpecialty" list="specialtySuggestions" class="form-control" placeholder="Select or type specialty..." oninput="syncLivePreview()" />
                                            <datalist id="specialtySuggestions">
                                                <option value="Cardiologist / Heart Specialist" />
                                                <option value="Diabetologist & Endocrinologist" />
                                                <option value="General Physician / Internal Medicine" />
                                                <option value="Pediatrician / Child Specialist" />
                                                <option value="Orthopedic Surgeon" />
                                                <option value="Dermatologist & Cosmetologist" />
                                                <option value="Obstetrician & Gynecologist" />
                                                <option value="Dentist / Orthodontist" />
                                                <option value="Neurologist / Neurosurgeon" />
                                                <option value="Ophthalmologist / Eye Specialist" />
                                                <option value="ENT Specialist (Otolaryngologist)" />
                                                <option value="Gastroenterologist" />
                                                <option value="Pulmonologist / Chest Physician" />
                                                <option value="Psychiatrist / Mental Health" />
                                                <option value="Oncologist / Cancer Specialist" />
                                                <option value="Urologist / Andrologist" />
                                                <option value="Nephrologist / Kidney Care" />
                                                <option value="Ayurveda Consultant" />
                                                <option value="Homeopathic Physician" />
                                                <option value="Physiotherapist / Rehab Specialist" />
                                            </datalist>
                                        </div>
                                        <small class="text-muted" style="font-size: 11px;">Choose from clinical list or enter custom field.</small>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="Qualifications" class="form-label fw-semibold text-dark small">Medical Qualifications</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="bi bi-mortarboard-fill"></i></span>
                                            <input asp-for="Qualifications" id="inputQualifications" class="form-control" placeholder="e.g. MBBS, MD (Cardiology), FACC" oninput="syncLivePreview()" />
                                        </div>
                                        <small class="text-muted" style="font-size: 11px;">Medical degrees shown under doctor's name on banners.</small>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="WebsiteUrl" class="form-label fw-semibold text-dark small">Professional Website / Practo URL</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="bi bi-globe2"></i></span>
                                            <input asp-for="WebsiteUrl" class="form-control" placeholder="https://www.drname.com" />
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="Bio" class="form-label fw-semibold text-dark small">About Doctor / Professional Bio</label>
                                        <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Brief summary of your clinical experience, special interests, and patient philosophy..."></textarea>
                                        <small class="text-muted" style="font-size: 11px;">Used when generating AI bio summaries and profile introductions.</small>
