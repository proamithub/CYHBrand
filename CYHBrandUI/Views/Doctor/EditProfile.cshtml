@section Scripts {
<script>
    // ── CSRF Token ──────────────────────────────────────────────────────────
    const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    // ── Global Helper for Tab Switching ─────────────────────────────────────
    function switchTab(buttonId) {
        const btn = document.getElementById(buttonId);
        if (btn) {
            const tabInstance = new bootstrap.Tab(btn);
            tabInstance.show();
            window.scrollTo({ top: 120, behavior: 'smooth' });
        }
    }

    function submitMainProfileForm() {
        const form = document.getElementById('profileForm');
        if (form.checkValidity()) {
            form.submit();
        } else {
            form.reportValidity();
        }
    }

    // ── Real-Time Live Sync: Form Inputs -> Avatar & Banner Footer Mockup ────
    function syncLivePreview() {
        const fullName = document.getElementById('inputFullName')?.value.trim() || 'Dr. Full Name';
        const displayName = document.getElementById('inputDisplayName')?.value.trim();
        const specialty = document.getElementById('inputSpecialty')?.value.trim() || 'Medical Specialist';
        const qualifications = document.getElementById('inputQualifications')?.value.trim() || 'MBBS, MD';
        const clinicName = document.getElementById('inputClinicName')?.value.trim() || 'Clinic / Hospital Name';
        const city = document.getElementById('inputCity')?.value.trim();
        const state = document.getElementById('inputState')?.value.trim();
        const pinCode = document.getElementById('inputPinCode')?.value.trim();
        const mobile = document.getElementById('inputMobileNo')?.value.trim() || '+91 98765 43210';
        const address = document.getElementById('inputClinicAddress')?.value.trim();

        // 1. Doctor Avatar Card
        const docFormattedName = fullName.toLowerCase().startsWith('dr.') ? fullName : ('Dr. ' + fullName);
        const nameEl = document.getElementById('liveDoctorName');
        if (nameEl) nameEl.textContent = docFormattedName;

        const specBadge = document.getElementById('liveSpecialtyBadge');
        if (specBadge) specBadge.textContent = specialty;

        const clinicTxt = document.getElementById('liveClinicNameTxt');
        if (clinicTxt) clinicTxt.textContent = clinicName;

        const cityTxt = document.getElementById('liveCityTxt');
        if (cityTxt) cityTxt.textContent = city ? (', ' + city) : '';

        // Update Avatar initials if no photo
        const initialEl = document.getElementById('liveAvatarPlaceholder');
        if (initialEl) {
            const raw = fullName.replace(/^dr\.?\s*/i, '').trim();
            initialEl.textContent = (raw.length >= 2 ? raw.substring(0, 2) : (raw.substring(0, 1) || 'DR')).toUpperCase();
        }

        // 2. Mockup Footer Ribbon
        const mockName = document.getElementById('mockupDocName');
        if (mockName) mockName.textContent = docFormattedName;

        const mockQual = document.getElementById('mockupDocQual');
        if (mockQual) {
            mockQual.innerHTML = qualifications + ' • <span id="mockupDocSpec">' + specialty + '</span>';
        }

        const mockClinic = document.getElementById('mockupClinicName');
        if (mockClinic) mockClinic.textContent = clinicName;

        const mockPhone = document.getElementById('mockupPhoneTxt');
        if (mockPhone) mockPhone.textContent = mobile;

        const mockAddress = document.getElementById('mockupAddressTxt');
        if (mockAddress) {
            const loc = [city, pinCode ? ('PIN ' + pinCode) : ''].filter(Boolean).join(' - ') || 'City, State';
            mockAddress.textContent = loc;
        }

        const mockInitial = document.getElementById('mockupAvatarInitial');
        if (mockInitial) {
            const raw = fullName.replace(/^dr\.?\s*/i, '').trim();
            mockInitial.textContent = (raw.length >= 2 ? raw.substring(0, 2) : (raw.substring(0, 1) || 'DR')).toUpperCase();
        }

        // Update Completeness
        calculateCompleteness();
    }

    // ── Brand Color Handlers ────────────────────────────────────────────────
    function updatePrimaryColor(hex) {
        if (!hex) return;
        document.getElementById('pickerPrimary').value = hex;
        document.getElementById('inputPrimaryHex').value = hex;
        document.getElementById('mockupFooterBox').style.backgroundColor = hex;
        document.getElementById('lblPrimaryHex').textContent = hex;
        const sampleBox = document.getElementById('liveFontSampleBox');
        if (sampleBox) sampleBox.style.backgroundColor = hex;
    }

    function updateSecondaryColor(hex) {
        if (!hex) return;
        document.getElementById('pickerSecondary').value = hex;
        document.getElementById('inputSecondaryHex').value = hex;
        document.getElementById('mockupAccentLine').style.backgroundColor = hex;
        const avatarWrap = document.getElementById('mockupAvatarWrap');
        if (avatarWrap) avatarWrap.style.borderColor = hex;
        const mockQual = document.getElementById('mockupDocQual');
        if (mockQual) mockQual.style.color = hex;
        const phoneIcon = document.querySelector('#mockupPhone i');
        if (phoneIcon) phoneIcon.style.color = hex;
        document.getElementById('lblSecondaryHex').textContent = hex;
        const sampleSub = document.getElementById('sampleSub');
        if (sampleSub) sampleSub.style.color = hex;
    }

    function updatePreferredFont(font) {
        if (!font) return;
        document.getElementById('selectPreferredFont').value = font;
        document.getElementById('mockupFooterBox').style.fontFamily = `"${font}", sans-serif`;
        document.getElementById('lblFontName').textContent = font;
        const sampleBox = document.getElementById('liveFontSampleBox');
        if (sampleBox) sampleBox.style.fontFamily = `"${font}", sans-serif`;
    }

    function applyBrandPreset(primary, secondary, font) {
        updatePrimaryColor(primary);
        updateSecondaryColor(secondary);
        updatePreferredFont(font);
        showToast('Applied ' + font + ' palette preset. Click "Save Changes" to persist.', 'info');
    }

    // ── Instant AJAX Save for Brand Settings ───────────────────────────────
    async function saveBrandSettingsAjax() {
        const primaryHex = document.getElementById('inputPrimaryHex')?.value || '#1B2B6B';
        const secondaryHex = document.getElementById('inputSecondaryHex')?.value || '#0EA5A0';
        const font = document.getElementById('selectPreferredFont')?.value || 'Inter';

        const body = new URLSearchParams({
            PrimaryColorHex: primaryHex,
            SecondaryColorHex: secondaryHex,
            PreferredFont: font
        });

        try {
            const res = await fetch('/Doctor/UpdateBrandSettings', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': csrfToken
                },
                body: body.toString()
            });
            const data = await res.json();
            if (data.isSuccess) {
                showToast('Brand settings & colors saved successfully!', 'success');
            } else {
                showToast(data.msg || 'Failed to save brand settings', 'danger');
            }
        } catch (err) {
            showToast('Network error saving brand settings', 'danger');
        }
    }

    // ── AJAX Upload: Doctor Profile Photo ──────────────────────────────────
    async function uploadDoctorAvatar(input) {
        const file = input.files?.[0];
        if (!file) return;

        const statusEl = document.getElementById('avatarUploadStatus');
        if (statusEl) {
            statusEl.innerHTML = '<span class="text-primary"><span class="spinner-border spinner-border-sm me-1"></span>Uploading photo...</span>';
        }

        const formData = new FormData();
        formData.append('file', file);

        try {
            const res = await fetch('/Doctor/UploadProfilePic', {
                method: 'POST',
                headers: { 'RequestVerificationToken': csrfToken },
                body: formData
            });
            const data = await res.json();
            if (data.isSuccess && data.filePath) {
                // 1. Update left avatar card
                const liveImg = document.getElementById('liveAvatarImg');
                const placeholder = document.getElementById('liveAvatarPlaceholder');
                if (liveImg) {
                    liveImg.src = data.filePath + '?t=' + new Date().getTime();
                } else if (placeholder) {
                    const img = document.createElement('img');
                    img.id = 'liveAvatarImg';
                    img.src = data.filePath;
                    img.alt = 'Doctor';
                    img.className = 'w-100 h-100';
                    img.style.objectFit = 'cover';
                    placeholder.replaceWith(img);
                }

                // 2. Update mockup footer avatar
                const mockImg = document.getElementById('mockupAvatarImg');
                const mockInitial = document.getElementById('mockupAvatarInitial');
                if (mockImg) {
                    mockImg.src = data.filePath + '?t=' + new Date().getTime();
                } else if (mockInitial) {
                    const img = document.createElement('img');
                    img.id = 'mockupAvatarImg';
                    img.src = data.filePath;
                    img.alt = 'Doctor';
                    img.className = 'w-100 h-100';
                    img.style.objectFit = 'cover';
                    mockInitial.replaceWith(img);
                }

                // 3. Update Tab 4 preview
                const tabPreview = document.getElementById('tabPhotoPreview');
                if (tabPreview) {
                    if (tabPreview.tagName === 'IMG') {
                        tabPreview.src = data.filePath + '?t=' + new Date().getTime();
                    } else {
                        const img = document.createElement('img');
                        img.id = 'tabPhotoPreview';
                        img.src = data.filePath;
                        img.className = 'rounded-circle shadow border border-3 border-white';
                        img.style.width = '120px';
                        img.style.height = '120px';
                        img.style.objectFit = 'cover';
                        tabPreview.replaceWith(img);
                    }
                }

                if (statusEl) {
                    statusEl.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Photo updated!</span>';
                }
                showToast('Doctor profile photo updated successfully!', 'success');
                calculateCompleteness();
            } else {
                if (statusEl) statusEl.innerHTML = '<span class="text-danger">' + (data.msg || 'Upload failed') + '</span>';
                showToast(data.msg || 'Upload failed', 'danger');
            }
        } catch (err) {
            if (statusEl) statusEl.innerHTML = '<span class="text-danger">Network error</span>';
            showToast('Error uploading photo', 'danger');
        }
    }

    // ── AJAX Upload: Clinic Logo ───────────────────────────────────────────
    async function uploadClinicLogo(input) {
        const file = input.files?.[0];
        if (!file) return;

        const statusEl = document.getElementById('logoUploadStatus');
        if (statusEl) {
            statusEl.innerHTML = '<span class="text-primary"><span class="spinner-border spinner-border-sm me-1"></span>Uploading logo...</span>';
        }

        const formData = new FormData();
        formData.append('file', file);

        try {
            const res = await fetch('/Doctor/UploadClinicLogo', {
                method: 'POST',
                headers: { 'RequestVerificationToken': csrfToken },
                body: formData
            });
            const data = await res.json();
            if (data.isSuccess && data.filePath) {
                // Update Card 3 preview
                const logoImg = document.getElementById('clinicLogoPreviewImg');
                const placeholder = document.getElementById('clinicLogoPlaceholder');
                if (placeholder) placeholder.classList.add('d-none');
                if (logoImg) {
                    logoImg.src = data.filePath + '?t=' + new Date().getTime();
                    logoImg.classList.remove('d-none');
                }

                // Update Tab 4 preview
                const tabLogo = document.getElementById('tabLogoPreview');
                if (tabLogo) {
                    if (tabLogo.tagName === 'IMG') {
                        tabLogo.src = data.filePath + '?t=' + new Date().getTime();
                    } else {
                        const img = document.createElement('img');
                        img.id = 'tabLogoPreview';
                        img.src = data.filePath;
                        img.style.maxHeight = '80px';
                        img.style.maxWidth = '150px';
                        img.style.objectFit = 'contain';
                        tabLogo.replaceWith(img);
                    }
                }

                if (statusEl) {
                    statusEl.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Logo uploaded!</span>';
                }
                showToast('Clinic logo uploaded successfully!', 'success');
            } else {
                if (statusEl) statusEl.innerHTML = '<span class="text-danger">' + (data.msg || 'Upload failed') + '</span>';
                showToast(data.msg || 'Upload failed', 'danger');
            }
        } catch (err) {
            if (statusEl) statusEl.innerHTML = '<span class="text-danger">Network error</span>';
            showToast('Error uploading logo', 'danger');
        }
    }

    // ── Profile Completeness Calculator ─────────────────────────────────────
    function calculateCompleteness() {
        const hasName = !!document.getElementById('inputFullName')?.value.trim();
        const hasSpec = !!document.getElementById('inputSpecialty')?.value.trim();
        const hasClinic = !!document.getElementById('inputClinicName')?.value.trim();
        const hasPhoto = !!document.getElementById('liveAvatarImg');
        const hasBrand = !!document.getElementById('inputPrimaryHex')?.value.trim();

        updateCheckBadge('chkName', hasName);
        updateCheckBadge('chkSpec', hasSpec);
        updateCheckBadge('chkClinic', hasClinic);
        updateCheckBadge('chkPhoto', hasPhoto);
        updateCheckBadge('chkBrand', hasBrand);

        const items = [hasName, hasSpec, hasClinic, hasPhoto, hasBrand];
        const score = Math.round((items.filter(Boolean).length / items.length) * 100);

        const percentEl = document.getElementById('completionPercent');
        const barEl = document.getElementById('completionBar');
        if (percentEl) percentEl.textContent = score + '%';
        if (barEl) {
            barEl.style.width = score + '%';
            barEl.className = 'progress-bar ' + (score === 100 ? 'bg-success' : (score > 60 ? 'bg-primary' : 'bg-warning'));
        }
    }

    function updateCheckBadge(elementId, isChecked) {
        const el = document.getElementById(elementId);
        if (!el) return;
        const icon = el.querySelector('i');
        if (!icon) return;
        if (isChecked) {
            icon.className = 'bi bi-check-circle-fill text-success';
        } else {
            icon.className = 'bi bi-circle text-muted';
        }
    }

    // ── Toast Notification Helper ───────────────────────────────────────────
    function showToast(message, type = 'info') {
        const toast = document.getElementById('ajaxToastMsg');
        const text = document.getElementById('ajaxToastText');
        const icon = document.getElementById('ajaxToastIcon');
        if (!toast || !text) return;

        text.textContent = message;
        toast.className = `alert alert-${type} alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4 d-flex align-items-center`;
        if (icon) {
            icon.className = type === 'success' ? 'bi bi-check-circle-fill fs-5 me-2' :
                             type === 'danger' ? 'bi bi-exclamation-circle-fill fs-5 me-2' : 'bi bi-info-circle-fill fs-5 me-2';
        }

        setTimeout(() => { hideToast(); }, 5000);
    }

    function hideToast() {
        const toast = document.getElementById('ajaxToastMsg');
        if (toast) toast.classList.add('d-none');
    }

    // ── Initial Setup on Page Load ──────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', () => {
        syncLivePreview();
        calculateCompleteness();
    });
</script>
}
