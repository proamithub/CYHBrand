@model CYHBrandModel.DTO.LoginDTO
@{
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Doctor Login — CYHBrand (Blazor Interactive)</title>
    <base href="~/" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .login-tab-btn {
            border: none;
            background: transparent;
            font-size: .88rem;
            font-weight: 600;
            color: #64748B;
            border-radius: 50rem;
            padding: .45rem 1rem;
            transition: all .2s ease;
        }
        .login-tab-btn.active {
            background: #fff;
            color: #1B2B6B;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }
        .otp-input-box {
            width: 46px;
            height: 52px;
            text-align: center;
            font-size: 1.4rem;
            font-weight: 700;
            border: 2px solid #E2E8F0;
            border-radius: 12px;
            background: #F8FAFC;
            color: #0F172A;
            transition: all .2s ease;
        }
        .otp-input-box:focus {
            border-color: #0EA5A0;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(14, 165, 160, 0.15);
            outline: none;
        }
        .pulse-highlight {
            animation: otpPulse 0.6s ease-in-out;
        }
        @@keyframes otpPulse {
            0% { transform: scale(1); border-color: #0EA5A0; }
            50% { transform: scale(1.08); border-color: #10B981; background: rgba(16, 185, 129, 0.12); }
            100% { transform: scale(1); border-color: #0EA5A0; }
        }
    </style>
</head>
<body style="margin:0;padding:0;">

<div class="cyh-login-page">
    <!-- ── Left Branding Panel ── -->
    <div class="cyh-login-left">
        <div class="cyh-login-logo">
            <i class="bi bi-heart-pulse-fill" style="color:#0EA5A0;"></i> CYHBrand
        </div>
        <div class="cyh-login-tagline">
            Doctor Branding &amp; AI Banner Studio<br>
            <small style="font-size:.8rem;opacity:.65;">Build Your Brand · Share Your Knowledge · Make a Healthier World</small>
        </div>
        <div class="cyh-login-features">
            <div class="cyh-login-feature">
                <div class="cyh-login-feature-icon"><i class="bi bi-stars"></i></div>
                <div class="cyh-login-feature-text">AI Banner<br>Creation</div>
            </div>
            <div class="cyh-login-feature">
                <div class="cyh-login-feature-icon"><i class="bi bi-grid-1x2"></i></div>
                <div class="cyh-login-feature-text">Ready<br>Templates</div>
            </div>
            <div class="cyh-login-feature">
                <div class="cyh-login-feature-icon"><i class="bi bi-share"></i></div>
                <div class="cyh-login-feature-text">Social Media<br>Sharing</div>
            </div>
            <div class="cyh-login-feature">
                <div class="cyh-login-feature-icon"><i class="bi bi-calendar-check"></i></div>
                <div class="cyh-login-feature-text">Schedule<br>Posts</div>
            </div>
        </div>
    </div>

    <!-- ── Right Form Panel (Hosted Blazor Interactive Component) ── -->
    <component type="typeof(CYHBrandUI.Components.DoctorLoginComponent)" 
               render-mode="ServerPrerendered" 
               param-ReturnUrl="@returnUrl" />
</div>

<!-- Hidden Form for standard cookie establishment -->
<form id="hiddenAuthForm" method="post" action="/Account/Login" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Email" id="hiddenEmail" />
    <input type="hidden" name="Password" id="hiddenPassword" />
    <input type="hidden" name="RememberMe" id="hiddenRememberMe" />
    <input type="hidden" name="returnUrl" value="@returnUrl" />
</form>

<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="_framework/blazor.server.js"></script>
<script>
    window.blazorAuthHelper = {
        focusDigit: function (index) {
            setTimeout(function () {
                var el = document.getElementById('blazorOtp_' + index);
                if (el) el.focus();
            }, 50);
        },
        submitLogin: function (data) {
            document.getElementById('hiddenEmail').value = data.email || '';
            document.getElementById('hiddenPassword').value = data.password || '';
            document.getElementById('hiddenRememberMe').value = data.rememberMe ? 'true' : 'false';
            document.getElementById('hiddenAuthForm').submit();
        },
        submitVerifyOtp: async function (data) {
            try {
                var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                var token = tokenEl ? tokenEl.value : '';

                var resp = await fetch('/Account/VerifyOtp', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(data)
                });

                var res = await resp.json();
                if (res.success) {
                    window.location.href = res.redirectUrl || '/';
                } else {
                    alert(res.message || 'OTP verification failed.');
                }
            } catch (err) {
                alert('Connection error during verification.');
            }
        }
    };
</script>
</body>
</html>
