@model CYHBrandModel.DTO.LoginDTO
@{
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Doctor Sign In — CYHBrand Clinical Branding Studio</title>
    <base href="~/" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* ══════════════════════════════════════════════════════════
           EXECUTIVE MEDICAL DOCTOR PORTAL THEME
           ══════════════════════════════════════════════════════════ */
        * { box-sizing: border-box; }
        body, html {
            height: 100%;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background: #F8FAFC;
            color: #0F172A;
            overflow-x: hidden;
        }

        .exec-login-container {
            min-height: 100vh;
            display: flex;
            background: #F8FAFC;
        }

        /* ══════════════════════════════════════════════════════════
           LEFT SIDE: CORPORATE CLINICAL CANVAS & GRACEFUL MOTION
           ══════════════════════════════════════════════════════════ */
        .exec-left-canvas {
            flex: 1.15;
            position: relative;
            background: linear-gradient(150deg, #091326 0%, #0F2144 55%, #0B1933 100%);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 56px 64px;
            color: #FFFFFF;
            overflow: hidden;
            border-right: 1px solid rgba(226, 232, 240, 0.1);
        }

        /* Elegant Grid Overlay */
        .exec-grid-pattern {
            position: absolute;
            inset: 0;
            background-image: 
                radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.08) 1px, transparent 0);
            background-size: 28px 28px;
            pointer-events: none;
            z-index: 1;
        }

        /* Subtle Ambient Glow (Refined & Soft, not neon) */
        .exec-glow-soft {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            pointer-events: none;
            z-index: 1;
            opacity: 0.25;
        }
        .exec-glow-teal {
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, #0EA5A0 0%, transparent 70%);
            top: -120px;
            left: -120px;
        }
        .exec-glow-blue {
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, #2563EB 0%, transparent 70%);
            bottom: -80px;
            right: -80px;
        }

        /* Floating Medical Caduceus / Cross Watermarks (Subtle, 4% Opacity) */
        .exec-watermark {
            position: absolute;
            color: rgba(255, 255, 255, 0.035);
            font-size: 26rem;
            right: -60px;
            top: 22%;
            pointer-events: none;
            z-index: 1;
            line-height: 1;
        }

        /* Brand Header */
        .exec-brand-logo {
            display: flex;
            align-items: center;
            gap: 14px;
            z-index: 2;
            position: relative;
        }
        .exec-logo-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: linear-gradient(135deg, #0EA5A0 0%, #0284C7 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            color: #fff;
            box-shadow: 0 8px 20px rgba(14, 165, 160, 0.35);
        }
        .exec-brand-title {
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #fff;
        }
        .exec-brand-subtitle {
            font-size: 0.78rem;
            color: rgba(255, 255, 255, 0.6);
            letter-spacing: 0.4px;
            text-transform: uppercase;
        }

        /* Hero Editorial Typography */
        .exec-hero-copy {
            margin: 40px 0 24px 0;
            z-index: 2;
            position: relative;
            max-width: 580px;
        }
        .exec-hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 50rem;
            background: rgba(14, 165, 160, 0.15);
            border: 1px solid rgba(14, 165, 160, 0.3);
            color: #2DD4BF;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin-bottom: 16px;
        }
        .exec-hero-title {
            font-size: 2.35rem;
            font-weight: 800;
            line-height: 1.22;
            letter-spacing: -0.8px;
            color: #FFFFFF;
            margin-bottom: 16px;
        }
        .exec-hero-desc {
            font-size: 0.98rem;
            line-height: 1.6;
            color: rgba(226, 232, 240, 0.75);
            font-weight: 400;
        }

        /* ── Continuous Graceful Pulse & Clinical Wave (Professional) ── */
        .exec-clinical-wave-box {
            position: relative;
            z-index: 2;
            background: rgba(15, 28, 54, 0.65);
            border: 1px solid rgba(255, 255, 255, 0.09);
            border-radius: 16px;
            padding: 20px 24px;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            margin-bottom: 32px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        }

        .exec-wave-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }
        .exec-status-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.78rem;
            color: #2DD4BF;
            font-weight: 600;
        }
        .pulse-dot-green {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #10B981;
            box-shadow: 0 0 10px #10B981;
            animation: pulseFade 1.8s infinite;
        }
        @@keyframes pulseFade {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.4); opacity: 0.4; }
        }

        .exec-wave-svg {
            width: 100%;
            height: 60px;
            overflow: visible;
        }
        .exec-pulse-path {
            fill: none;
            stroke: #0EA5A0;
            stroke-width: 2.2;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-dasharray: 600;
            stroke-dashoffset: 600;
            animation: drawWave 4s linear infinite;
        }
        @@keyframes drawWave {
            0% { stroke-dashoffset: 600; }
            100% { stroke-dashoffset: 0; }
        }

        .exec-wave-beam {
            position: absolute;
            width: 100px;
            height: 100%;
            top: 0;
            background: linear-gradient(90deg, transparent, rgba(45, 212, 191, 0.25), transparent);
            animation: beamTravel 4s linear infinite;
            pointer-events: none;
        }
        @@keyframes beamTravel {
            0% { left: 0; }
            100% { left: 100%; }
        }

        /* Verified Metrics Bar */
        .exec-metrics-row {
            display: flex;
            align-items: center;
            gap: 32px;
            z-index: 2;
            position: relative;
            padding-top: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }
        .exec-metric-item {
            display: flex;
            flex-direction: column;
        }
        .exec-metric-val {
            font-size: 1.25rem;
            font-weight: 800;
            color: #FFFFFF;
            letter-spacing: -0.3px;
        }
        .exec-metric-lbl {
            font-size: 0.75rem;
            color: rgba(226, 232, 240, 0.6);
            margin-top: 2px;
        }

        /* ══════════════════════════════════════════════════════════
           RIGHT SIDE: PRISTINE WHITE CORPORATE LOGIN PANEL
           ══════════════════════════════════════════════════════════ */
        .exec-right-panel {
            flex: 0.95;
            background: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 56px 48px;
            position: relative;
            z-index: 5;
        }

        .exec-login-card {
            width: 100%;
            max-width: 440px;
        }

        /* Tab Switcher */
        .exec-tab-wrap {
            display: flex;
            background: #F1F5F9;
            border-radius: 12px;
            padding: 4px;
            margin-bottom: 28px;
            border: 1px solid #E2E8F0;
        }
        .login-tab-btn {
            flex: 1;
            border: none;
            background: transparent;
            font-size: 0.86rem;
            font-weight: 600;
            color: #64748B;
            border-radius: 8px;
            padding: 8px 14px;
            transition: all 0.18s ease;
            text-align: center;
        }
        .login-tab-btn.active {
            background: #FFFFFF;
            color: #0F172A;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
            font-weight: 700;
        }

        /* Inputs & Controls */
        .form-control.cyh-form-control {
            border: 1.5px solid #E2E8F0;
            border-radius: 10px;
            padding: 11px 14px 11px 44px;
            font-size: 0.9rem;
            color: #0F172A;
            background: #FFFFFF;
            transition: all 0.18s ease;
        }
        .form-control.cyh-form-control:focus {
            border-color: #0EA5A0;
            box-shadow: 0 0 0 3px rgba(14, 165, 160, 0.12);
            background: #FFFFFF;
        }

        /* OTP Input Boxes */
        .otp-input-box {
            width: 48px;
            height: 52px;
            text-align: center;
            font-size: 1.4rem;
            font-weight: 700;
            border: 1.5px solid #CBD5E1;
            border-radius: 10px;
            background: #F8FAFC;
            color: #0F172A;
            transition: all 0.18s ease;
        }
        .otp-input-box:focus {
            border-color: #0EA5A0;
            background: #FFFFFF;
            box-shadow: 0 0 0 3px rgba(14, 165, 160, 0.15);
            outline: none;
        }

        /* Primary Button */
        .btn-exec-primary {
            background: #0B1B3D;
            color: #FFFFFF;
            font-weight: 600;
            font-size: 0.92rem;
            border: none;
            border-radius: 10px;
            padding: 12px 20px;
            transition: all 0.2s ease;
            width: 100%;
        }
        .btn-exec-primary:hover {
            background: #152A55;
            color: #FFFFFF;
            box-shadow: 0 4px 14px rgba(11, 27, 61, 0.2);
            transform: translateY(-1px);
        }

        /* Responsive */
        @@media (max-width: 991.98px) {
            .exec-login-container {
                flex-direction: column;
            }
            .exec-left-canvas {
                padding: 40px 24px;
            }
            .exec-right-panel {
                padding: 40px 24px;
            }
            .exec-metrics-row {
                gap: 20px;
            }
        }
    </style>
</head>
<body>

<div class="exec-login-container">
    <!-- ══════════════════════════════════════════════════════════
         LEFT PANEL: PROFESSIONAL CLINICAL CANVAS & WAVE DYNAMICS
         ══════════════════════════════════════════════════════════ -->
    <div class="exec-left-canvas">
        <div class="exec-grid-pattern"></div>
        <div class="exec-glow-soft exec-glow-teal"></div>
        <div class="exec-glow-soft exec-glow-blue"></div>
        <i class="bi bi-heart-pulse exec-watermark"></i>

        <!-- Brand Top Bar -->
        <div class="exec-brand-logo">
            <div class="exec-logo-icon">
                <i class="bi bi-heart-pulse-fill"></i>
            </div>
            <div>
                <div class="exec-brand-title">CYH<span style="color:#2DD4BF;">Brand</span></div>
                <div class="exec-brand-subtitle">Clinical Branding &amp; Patient Outreach</div>
            </div>
        </div>

        <!-- Hero Editorial Copy -->
        <div class="exec-hero-copy">
            <div class="exec-hero-tag">
                <i class="bi bi-patch-check-fill text-warning"></i> Official Physician Portal
            </div>
            <h1 class="exec-hero-title">
                Elevating Doctor Brands with Clinical Precision.
            </h1>
            <p class="exec-hero-desc">
                Access your verified branding dashboard to publish medically accurate patient awareness posts, manage OPD schedules, and curate clinic creatives in seconds.
            </p>
        </div>

        <!-- Professional Clinical Continuous Wave Monitor -->
        <div class="exec-clinical-wave-box">
            <div class="exec-wave-header">
                <div class="exec-status-chip">
                    <span class="pulse-dot-green"></span>
                    <span>Clinical Network Live • 256-Bit SSL Encrypted</span>
                </div>
                <span class="badge bg-white bg-opacity-10 text-white-50 px-2 py-1 rounded-pill small" style="font-size:10px;">
                    LEAD-II ECG
                </span>
            </div>

            <!-- Waveform SVG with continuous draw animation -->
            <div class="position-relative overflow-hidden" style="height: 60px;">
                <div class="exec-wave-beam"></div>
                <svg viewBox="0 0 600 80" class="exec-wave-svg" preserveAspectRatio="none">
                    <path class="exec-pulse-path" d="
                        M 0 45 
                        L 60 45 
                        L 75 45 
                        L 85 36 
                        L 95 45 
                        L 110 45 
                        L 120 54 
                        L 130 10 
                        L 140 75 
                        L 150 45 
                        L 170 45 
                        L 185 34 
                        L 200 45 
                        L 260 45 
                        L 275 45 
                        L 285 36 
                        L 295 45 
                        L 310 45 
                        L 320 54 
                        L 330 10 
                        L 340 75 
                        L 350 45 
                        L 370 45 
                        L 385 34 
                        L 400 45 
                        L 460 45 
                        L 475 45 
                        L 485 36 
                        L 495 45 
                        L 510 45 
                        L 520 54 
                        L 530 10 
                        L 540 75 
                        L 550 45 
                        L 570 45 
                        L 585 34 
                        L 600 45" />
                </svg>
            </div>
        </div>

        <!-- Verified Credibility Metrics -->
        <div class="exec-metrics-row">
            <div class="exec-metric-item">
                <span class="exec-metric-val">10,000+</span>
                <span class="exec-metric-lbl">Verified Doctors</span>
            </div>
            <div class="exec-metric-item">
                <span class="exec-metric-val">48+</span>
                <span class="exec-metric-lbl">Medical Specialties</span>
            </div>
            <div class="exec-metric-item">
                <span class="exec-metric-val">100%</span>
                <span class="exec-metric-lbl">Clinically Compliant</span>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════
         RIGHT PANEL: CLEAN EXECUTIVE DOCTOR LOGIN
         ══════════════════════════════════════════════════════════ -->
    <div class="exec-right-panel">
        <div class="exec-login-card">
            <component type="typeof(CYHBrandUI.Components.DoctorLoginComponent)" 
                       render-mode="ServerPrerendered" 
                       param-ReturnUrl="@returnUrl" />
        </div>
    </div>
</div>

<!-- Hidden Form for standard cookie establishment -->
<form id="hiddenAuthForm" method="post" action="/Account/Login" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Email" id="hiddenEmail" />
    <input type="hidden" name="Password" id="hiddenPassword" />
    <input type="hidden" name="RememberMe" id="hiddenRememberMe" />
    <input type="hidden" name="returnUrl" value="@returnUrl" />
</form>

<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="_framework/blazor.server.js"></script>
<script>
    window.blazorAuthHelper = {
        focusDigit: function (index) {
            setTimeout(function () {
                var el = document.getElementById('blazorOtp_' + index);
                if (el) el.focus();
            }, 50);
        },
        submitLogin: function (data) {
            document.getElementById('hiddenEmail').value = data.email || '';
            document.getElementById('hiddenPassword').value = data.password || '';
            document.getElementById('hiddenRememberMe').value = data.rememberMe ? 'true' : 'false';
            document.getElementById('hiddenAuthForm').submit();
        },
        submitVerifyOtp: async function (data) {
            try {
                var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                var token = tokenEl ? tokenEl.value : '';

                var resp = await fetch('/Account/VerifyOtp', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(data)
                });

                var res = await resp.json();
                if (res.success) {
                    window.location.href = res.redirectUrl || '/';
                } else {
                    alert(res.message || 'OTP verification failed.');
                }
            } catch (err) {
                alert('Connection error during verification.');
            }
        }
    };
</script>
</body>
</html>
