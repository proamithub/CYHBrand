@model CYHBrandModel.DTO.DoctorMasterDTO
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register – CYHBrand</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background:linear-gradient(135deg,#1a1f36 0%,#3949ab 100%); min-height:100vh; display:flex; align-items:center; justify-content:center; padding:30px 0; }
        .card { border:none; border-radius:16px; box-shadow:0 10px 40px rgba(0,0,0,.3); }
        .brand-title { color:#3949ab; font-weight:800; font-size:1.6rem; }
    </style>
</head>
<body>
<div class="card p-4" style="min-width:420px;max-width:480px;width:100%">
    <div class="text-center mb-3">
        <div class="brand-title"><i class="bi bi-heart-pulse-fill text-danger"></i> CYHBrand</div>
        <p class="text-muted small">Create your doctor account</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
    }

    <form asp-action="Register" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-2">
            <div class="col-12">
                <label asp-for="FullName" class="form-label fw-semibold">Full Name *</label>
                <input asp-for="FullName" class="form-control" placeholder="Dr. Ravi Sharma" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Email" class="form-label fw-semibold">Email *</label>
                <input asp-for="Email" class="form-control" placeholder="doctor@email.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="MobileNo" class="form-label fw-semibold">Mobile No</label>
                <input asp-for="MobileNo" class="form-control" placeholder="9876543210" />
            </div>
            <div class="col-12">
                <label asp-for="Specialty" class="form-label fw-semibold">Specialty</label>
                <input asp-for="Specialty" class="form-control" placeholder="e.g. Cardiologist" />
            </div>
            <div class="col-12">
                <label asp-for="Password" class="form-label fw-semibold">Password *</label>
                <input asp-for="Password" class="form-control" placeholder="Min 6 characters" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password *</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-primary w-100 mt-3 py-2 fw-semibold">
            <i class="bi bi-person-plus-fill me-1"></i> Register
        </button>
    </form>
    <hr class="my-3" />
    <div class="text-center small">
        Already registered? <a asp-controller="Account" asp-action="Login" class="fw-semibold">Login here</a>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
