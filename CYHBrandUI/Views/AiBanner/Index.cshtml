@{
    ViewData["Title"] = "AI Banner Creator";
    ViewData["PageSubtitle"] = "Create branded, high-impact medical awareness banners with AI in seconds.";
    var doctor = ViewBag.Doctor as CYHBrandUI.Helpers.CustomPrincipal;
    string docName = !string.IsNullOrWhiteSpace(doctor?.FullName) ? doctor.FullName : (!string.IsNullOrWhiteSpace(doctor?.Name) ? doctor.Name : "Dr. Specialist");
    if (!docName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase)) docName = "Dr. " + docName;
}

<div class="row g-4">
    <!-- ── Left Column: AI Prompt & Configuration ── -->
    <div class="col-lg-5">
        <!-- ── ⚡ 1-Click Auto-Generate Banner Feature Card ── -->
        <div class="card border-0 text-white shadow-sm mb-4" style="background:linear-gradient(135deg, #091E42 0%, #173873 55%, #0EA5A0 100%); border-radius:14px; overflow:hidden;">
            <div class="card-body p-4 position-relative">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="badge bg-warning text-dark fw-bold px-2 py-1" style="font-size:0.75rem;">
                        <i class="bi bi-lightning-charge-fill me-1"></i>INSTANT 1-CLICK AI
                    </span>
                    <span class="badge rounded-pill bg-white text-dark bg-opacity-25" style="font-size:0.7rem;">
                        Zero Effort Required
                    </span>
                </div>
                <h5 class="fw-bold text-white mb-1">Auto-Generate Full Banner</h5>
                <p class="text-white-50 small mb-3">
                    Click below to immediately generate a complete, ready-to-share clinical awareness banner with your doctor branding.
                </p>

                <!-- Big 1-Click Action Button -->
                <button type="button" class="btn btn-warning text-dark fw-bold w-100 py-2 mb-3 d-flex align-items-center justify-content-center gap-2 shadow" onclick="instantAutoGenerate()" style="border-radius:10px;">
                    <i class="bi bi-magic fs-5"></i>
                    <span>⚡ 1-Click Auto-Generate Full Banner</span>
                </button>

                <!-- Quick Ready Themes Pills -->
                <div class="small fw-semibold text-white-50 mb-2">Or pick a 1-click clinical campaign:</div>
                <div class="d-flex flex-wrap gap-1">
                    <button type="button" class="btn btn-sm btn-outline-light py-1 px-2 rounded-pill bg-white bg-opacity-10 border-white-50 text-white" onclick="instantAutoGenerate(0)" title="Auto-generate Heart Health banner">
                        ❤️ Heart
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light py-1 px-2 rounded-pill bg-white bg-opacity-10 border-white-50 text-white" onclick="instantAutoGenerate(1)" title="Auto-generate Diabetes banner">
                        🩸 Diabetes
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light py-1 px-2 rounded-pill bg-white bg-opacity-10 border-white-50 text-white" onclick="instantAutoGenerate(2)" title="Auto-generate Monsoon Flu banner">
                        🌧️ Flu/Monsoon
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light py-1 px-2 rounded-pill bg-white bg-opacity-10 border-white-50 text-white" onclick="instantAutoGenerate(3)" title="Auto-generate Nutrition banner">
                        🥗 Nutrition
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light py-1 px-2 rounded-pill bg-white bg-opacity-10 border-white-50 text-white" onclick="instantAutoGenerate(4)" title="Auto-generate Child Health banner">
                        👶 Pediatric
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light py-1 px-2 rounded-pill bg-white bg-opacity-10 border-white-50 text-white" onclick="instantAutoGenerate(5)" title="Auto-generate Eye Care banner">
                        👁️ Eye Care
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light py-1 px-2 rounded-pill bg-white bg-opacity-10 border-white-50 text-white" onclick="instantAutoGenerate(6)" title="Auto-generate Mental Wellness banner">
                        🧠 Mental Peace
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light py-1 px-2 rounded-pill bg-white bg-opacity-10 border-white-50 text-white" onclick="instantAutoGenerate(8)" title="Auto-generate Hindi Heart Banner">
                        🇮🇳 हिंदी हृदय
                    </button>
                </div>
            </div>
        </div>

        <div class="cyh-card shadow-sm mb-4">
            <div class="cyh-card-header d-flex align-items-center justify-content-between">
                <h6 class="cyh-card-title mb-0">
                    <i class="bi bi-stars me-2" style="color:#0EA5A0;"></i>AI Creative Controls
                </h6>
                <span class="badge rounded-pill bg-light text-primary border" style="font-size:0.75rem;">
                    <i class="bi bi-cpu me-1"></i>Medical Engine v2.0
                </span>
            </div>
            
            <div class="cyh-card-body">
                <!-- 1. Topic & Quick Chips -->
                <div class="mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <label class="cyh-form-label fw-bold mb-0">1. Select or Enter Medical Topic</label>
                        <div class="d-flex align-items-center gap-2">
                            <a href="/Calendar" class="btn btn-link btn-sm text-decoration-none p-0 text-primary fw-semibold" style="font-size:0.75rem;" title="Browse Indian Medical Calendar">
                                <i class="bi bi-calendar-event me-1"></i>Health Calendar
                            </a>
                            <span class="text-muted small">·</span>
                            <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 text-teal fw-semibold" onclick="shuffleTopic()" title="Suggest a random medical awareness topic" style="font-size:0.75rem;color:#0EA5A0 !important;">
                                <i class="bi bi-shuffle me-1"></i>Suggest Topic
                            </button>
                        </div>
                    </div>

                    <!-- Category Switcher Tabs -->
                    <div class="d-flex gap-2 mb-2 pb-1 border-bottom" style="font-size:0.78rem;">
                        <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 fw-bold topic-tab active" id="tabGeneral" onclick="switchTopicTab('general')" style="color:#0EA5A0 !important;">
                            🏥 Clinical Topics
                        </button>
                        <span class="text-muted">|</span>
                        <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-secondary fw-semibold topic-tab" id="tabIndian" onclick="switchTopicTab('indian')">
                            🇮🇳 Indian Calendar &amp; Festivals
                        </button>
                    </div>

                    <!-- Clinical Chips -->
                    <div id="chipsGeneral" class="d-flex flex-wrap gap-1 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-pill topic-chip" onclick="selectTopic(this, 'Heart Health & Blood Pressure')">
                            ❤️ Heart Care
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-pill topic-chip" onclick="selectTopic(this, 'Diabetes Management & Sugar Control')">
                            🩸 Diabetes
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-pill topic-chip" onclick="selectTopic(this, 'Monsoon & Flu Prevention Tips')">
                            🌧️ Seasonal Flu
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-pill topic-chip" onclick="selectTopic(this, 'Balanced Nutrition & Daily Diet')">
                            🥗 Nutrition
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-pill topic-chip" onclick="selectTopic(this, 'Child Growth & Vaccination Schedule')">
                            👶 Pediatric Care
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-pill topic-chip" onclick="selectTopic(this, 'Daily Dental Hygiene & Oral Care')">
                            🦷 Dental Care
                        </button>
                    </div>

                    <!-- Indian Calendar & Festivals Chips -->
                    <div id="chipsIndian" class="d-flex flex-wrap gap-1 mb-2" style="display:none !important;">
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-pill topic-chip" onclick="selectTopic(this, 'National Doctor\'s Day: Honoring Healers & Preventive Health Checkups')">
                            🩺 Doctor's Day (July 1)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-pill topic-chip" onclick="selectTopic(this, 'International Yoga Day: Daily Asanas, Pranayama & Mental Peace')">
                            🧘 Yoga Day (June 21)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-pill topic-chip" onclick="selectTopic(this, 'World Blood Donor Day: Give Blood, Save Precious Lives')">
                            🩸 Blood Donor Day (June 14)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-pill topic-chip" onclick="selectTopic(this, 'Safe & Healthy Green Diwali: Clean Lungs, Burn Care & Sugar Control')">
                            🪔 Diwali Safe Health
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-pill topic-chip" onclick="selectTopic(this, 'National Nutrition Week: Balanced Indian Thali & Pure Eating')">
                            🥗 Nutrition Week (Sep 1-7)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-pill topic-chip" onclick="selectTopic(this, 'National Dengue Day: Stopping Mosquito Breeding & Platelet Care')">
                            🦟 Dengue Day (May 16)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-pill topic-chip" onclick="selectTopic(this, 'Swasth Bharat: National Health, Hygiene & Wellness Pledge')">
                            🇮🇳 Swasth Bharat (Jan 26 / Aug 15)
                        </button>
                    </div>

                    <textarea id="aiTopic" class="form-control cyh-form-control" rows="2"
                              placeholder="e.g. 5 essential tips to prevent high blood pressure..."></textarea>
                </div>

                <!-- 2. Language Selection -->
                <div class="mb-3">
                    <label class="cyh-form-label fw-bold">2. Banner Language</label>
                    <select id="aiLanguage" class="form-select cyh-form-control">
                        <option value="English" selected>English</option>
                        <option value="Hindi">हिंदी (Hindi)</option>
                        <option value="Marathi">मराठी (Marathi)</option>
                        <option value="Tamil">தமிழ் (Tamil)</option>
                        <option value="Gujarati">ગુજરાતી (Gujarati)</option>
                        <option value="Bengali">বাংলা (Bengali)</option>
                    </select>
                </div>

                <!-- 3. Design Style -->
                <div class="mb-3">
                    <label class="cyh-form-label fw-bold">3. Design Palette &amp; Style</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="style-card p-2 border rounded-3 text-center cursor-pointer active" onclick="selectStyle(this, 'Modern')" style="cursor:pointer;border:2px solid #0EA5A0 !important;background:#F0FDFA;">
                                <div class="d-flex align-items-center justify-content-center gap-1 mb-1">
                                    <span style="width:14px;height:14px;border-radius:50%;background:#0B1B3D;display:inline-block;"></span>
                                    <span style="width:14px;height:14px;border-radius:50%;background:#0EA5A0;display:inline-block;"></span>
                                </div>
                                <div class="fw-semibold small text-dark">Modern Medical</div>
                                <div class="text-muted" style="font-size:0.7rem;">Navy &amp; Teal Accent</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="style-card p-2 border rounded-3 text-center cursor-pointer" onclick="selectStyle(this, 'Minimal')" style="cursor:pointer;">
                                <div class="d-flex align-items-center justify-content-center gap-1 mb-1">
                                    <span style="width:14px;height:14px;border-radius:50%;background:#F8FAFC;border:1px solid #ccc;display:inline-block;"></span>
                                    <span style="width:14px;height:14px;border-radius:50%;background:#2563EB;display:inline-block;"></span>
                                </div>
                                <div class="fw-semibold small text-dark">Clean Minimal</div>
                                <div class="text-muted" style="font-size:0.7rem;">Light &amp; Royal Blue</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="style-card p-2 border rounded-3 text-center cursor-pointer" onclick="selectStyle(this, 'Colorful')" style="cursor:pointer;">
                                <div class="d-flex align-items-center justify-content-center gap-1 mb-1">
                                    <span style="width:14px;height:14px;border-radius:50%;background:#064E3B;display:inline-block;"></span>
                                    <span style="width:14px;height:14px;border-radius:50%;background:#F59E0B;display:inline-block;"></span>
                                </div>
                                <div class="fw-semibold small text-dark">Energetic Green</div>
                                <div class="text-muted" style="font-size:0.7rem;">Emerald &amp; Warm Gold</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="style-card p-2 border rounded-3 text-center cursor-pointer" onclick="selectStyle(this, 'Professional')" style="cursor:pointer;">
                                <div class="d-flex align-items-center justify-content-center gap-1 mb-1">
                                    <span style="width:14px;height:14px;border-radius:50%;background:#0F172A;display:inline-block;"></span>
                                    <span style="width:14px;height:14px;border-radius:50%;background:#38BDF8;display:inline-block;"></span>
                                </div>
                                <div class="fw-semibold small text-dark">Midnight Slate</div>
                                <div class="text-muted" style="font-size:0.7rem;">Dark &amp; Cyan Glow</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. Dimensions & Aspect Ratio -->
                <div class="mb-3">
                    <label class="cyh-form-label fw-bold">4. Dimensions &amp; Orientation</label>
                    <select id="aiOrientation" class="form-select cyh-form-control">
                        <option value="Square" selected>Square (1:1) – 1080 × 1080 px (Instagram &amp; WhatsApp Post)</option>
                        <option value="Portrait">Portrait / Story (9:16) – 1080 × 1920 px (Stories &amp; Status)</option>
                        <option value="Landscape">Landscape / Banner (16:9) – 1920 × 1080 px (Twitter &amp; Web)</option>
                        <option value="Facebook">Facebook Feed (1.91:1) – 1200 × 630 px (Facebook &amp; LinkedIn)</option>
                    </select>
                </div>

                <!-- 5. Doctor Branding Context -->
                <div class="p-3 bg-light rounded-3 mb-4 border">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="chkIncludeBranding" checked />
                        <label class="form-check-label fw-semibold small text-dark" for="chkIncludeBranding">
                            Embed My Doctor Branding Footer
                        </label>
                    </div>
                    <div class="d-flex align-items-center gap-2 text-muted" style="font-size:0.75rem;">
                        <i class="bi bi-person-badge fs-5 text-teal"></i>
                        <div>
                            <div><strong>@docName</strong> · @(doctor?.Specialty ?? "Medical Specialist")</div>
                            <div>@(doctor?.ClinicName ?? "Clinic") · @(doctor?.MobileNo ?? "Contact")</div>
                        </div>
                    </div>
                </div>

                <!-- Generate Action Button -->
                <button type="button" id="btnGenerate" class="btn btn-cyh-teal w-100 py-3 d-flex align-items-center justify-content-center gap-2 shadow-sm" onclick="triggerAiGeneration()">
                    <i class="bi bi-stars fs-5"></i>
                    <span id="btnGenText" class="fw-bold">Generate Branded Banner with AI</span>
                </button>

            </div>
        </div>
    </div>

    <!-- ── Right Column: Interactive Live Preview ── -->
    <div class="col-lg-7">
        <div class="cyh-card shadow-sm h-100 d-flex flex-column">
            <div class="cyh-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="p-1 rounded bg-teal-subtle text-teal">
                        <i class="bi bi-eye-fill" style="color:#0EA5A0;"></i>
                    </span>
                    <h6 class="cyh-card-title mb-0">Generated Preview</h6>
                    <span id="previewStatusBadge" class="badge rounded-pill bg-light text-muted border ms-2" style="font-size:.7rem;">
                        Ready
                    </span>
                </div>
                
                <!-- Zoom & Action Controls -->
                <div class="d-flex align-items-center gap-1" id="previewControls" style="display:none !important;">
                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size:0.75rem;" onclick="zoomAiPreview(-0.1)" title="Zoom Out">
                        <i class="bi bi-zoom-out"></i>
                    </button>
                    <span id="aiZoomLabel" style="font-size:0.75rem;min-width:38px;text-align:center;font-weight:600;color:#64748B;">100%</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size:0.75rem;" onclick="zoomAiPreview(0.1)" title="Zoom In">
                        <i class="bi bi-zoom-in"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size:0.75rem;" onclick="resetAiZoom()" title="Fit">
                        Fit
                    </button>
                </div>
            </div>

            <!-- 🎨 Change Background Toolbar (Shown once banner is generated) -->
            <div id="aiBgToolbar" class="px-3 py-2 bg-white border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2" style="display:none !important;">
                <div class="d-flex align-items-center gap-1 flex-wrap">
                    <span class="small fw-bold text-dark me-2" style="font-size:0.75rem;">
                        <i class="bi bi-palette-fill me-1" style="color:#0EA5A0;"></i>Background:
                    </span>
                    <!-- Solid Palette Swatches -->
                    <button type="button" class="btn btn-sm rounded-circle p-0" style="width:22px;height:22px;background:#0B1B3D;border:2px solid #fff;box-shadow:0 0 3px rgba(0,0,0,0.3);" onclick="changeCanvasBg('#0B1B3D')" title="Deep Navy"></button>
                    <button type="button" class="btn btn-sm rounded-circle p-0" style="width:22px;height:22px;background:#0F172A;border:2px solid #fff;box-shadow:0 0 3px rgba(0,0,0,0.3);" onclick="changeCanvasBg('#0F172A')" title="Midnight Slate"></button>
                    <button type="button" class="btn btn-sm rounded-circle p-0" style="width:22px;height:22px;background:#1E1B4B;border:2px solid #fff;box-shadow:0 0 3px rgba(0,0,0,0.3);" onclick="changeCanvasBg('#1E1B4B')" title="Royal Indigo"></button>
                    <button type="button" class="btn btn-sm rounded-circle p-0" style="width:22px;height:22px;background:#064E3B;border:2px solid #fff;box-shadow:0 0 3px rgba(0,0,0,0.3);" onclick="changeCanvasBg('#064E3B')" title="Emerald Dark"></button>
                    <button type="button" class="btn btn-sm rounded-circle p-0" style="width:22px;height:22px;background:#0D3B43;border:2px solid #fff;box-shadow:0 0 3px rgba(0,0,0,0.3);" onclick="changeCanvasBg('#0D3B43')" title="Deep Teal"></button>
                    <button type="button" class="btn btn-sm rounded-circle p-0" style="width:22px;height:22px;background:#4C0519;border:2px solid #fff;box-shadow:0 0 3px rgba(0,0,0,0.3);" onclick="changeCanvasBg('#4C0519')" title="Burgundy Crimson"></button>
                    <button type="button" class="btn btn-sm rounded-circle p-0" style="width:22px;height:22px;background:#18181B;border:2px solid #fff;box-shadow:0 0 3px rgba(0,0,0,0.3);" onclick="changeCanvasBg('#18181B')" title="Warm Charcoal"></button>
                    <button type="button" class="btn btn-sm rounded-circle p-0" style="width:22px;height:22px;background:#F8FAFC;border:2px solid #CBD5E1;box-shadow:0 0 3px rgba(0,0,0,0.15);" onclick="changeCanvasBg('#F8FAFC')" title="Clean White"></button>

                    <span class="text-muted mx-1" style="font-size:0.75rem;">|</span>

                    <!-- Gradient Swatches -->
                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 rounded-pill" style="font-size:0.72rem;" onclick="changeCanvasBg('gradient:teal-navy')">Teal-Navy</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 rounded-pill" style="font-size:0.72rem;" onclick="changeCanvasBg('gradient:emerald-gold')">Emerald</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 rounded-pill" style="font-size:0.72rem;" onclick="changeCanvasBg('gradient:midnight-purple')">Midnight</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 rounded-pill" style="font-size:0.72rem;" onclick="changeCanvasBg('gradient:crimson-dark')">Crimson</button>
                </div>

                <!-- Custom Color Picker -->
                <div class="d-flex align-items-center gap-1 ms-auto">
                    <label for="aiCustomBgInput" class="small text-muted mb-0 fw-semibold" style="font-size:0.72rem;">Custom Color:</label>
                    <input type="color" id="aiCustomBgInput" value="#0B1B3D" class="form-control form-control-color p-0 border-0" style="width:26px;height:24px;cursor:pointer;border-radius:4px;" onchange="changeCanvasBg(this.value)" title="Choose custom background color">
                </div>
            </div>

            <!-- Viewport Stage -->
            <div class="cyh-card-body flex-grow-1 d-flex align-items-center justify-content-center position-relative p-4"
                 style="min-height:500px;background:#F8FAFC;background-image:radial-gradient(#CBD5E1 1.2px, transparent 1.2px);background-size:20px 20px;border-radius:0 0 14px 14px;overflow:auto;">
                
                <!-- Empty Placeholder -->
                <div id="aiEmptyState" class="text-center py-5">
                    <div style="width:260px;height:260px;margin:auto;
                                background:linear-gradient(135deg,#1B2B6B,#0EA5A0);
                                border-radius:24px;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 14px 35px rgba(27,43,107,.2);">
                        <i class="bi bi-stars text-white" style="font-size:4.5rem;opacity:.95;"></i>
                        <span class="text-white mt-2 fw-semibold opacity-90">AI Banner Studio</span>
                    </div>
                    <h5 class="mt-4 fw-bold text-dark">Your Banner Will Appear Here</h5>
                    <p class="text-muted small mx-auto" style="max-width:380px;">
                        Choose a medical topic on the left, pick your favorite language and style, then click <strong>Generate with AI</strong>.
                    </p>
                </div>

                <!-- Loading Animation -->
                <div id="aiLoadingState" class="text-center py-5" style="display:none;">
                    <div class="spinner-border text-teal mb-3" style="width:3.5rem;height:3.5rem;color:#0EA5A0 !important;" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <h5 class="fw-bold text-dark" id="aiLoadingStep">Generating Branded Medical Concept...</h5>
                    <p class="text-muted small">Synthesizing clinical advice, typography, and doctor branding...</p>
                </div>

                <!-- Live Canvas Display -->
                <div id="aiCanvasWrapper" style="display:none;transition:transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);transform-origin:center center;">
                    <canvas id="aiCanvas" class="rounded-3 shadow-lg" style="max-width:100%;max-height:520px;background:#ffffff;border:1px solid #E2E8F0;"></canvas>
                </div>

            </div>

            <!-- Bottom Actions Bar (Shown once generated) -->
            <div id="aiActionBar" class="p-3 border-top bg-white d-flex align-items-center justify-content-between flex-wrap gap-2" style="display:none !important;border-radius:0 0 14px 14px;">
                <div class="d-flex align-items-center gap-2">
                    <span id="canvasDimInfo" class="badge bg-light text-secondary border">1080 × 1080 px</span>
                    <span class="text-muted small"><i class="bi bi-check-circle-fill text-success me-1"></i>Generated Ready</span>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="triggerAiGeneration()">
                        <i class="bi bi-arrow-repeat me-1"></i>Regenerate
                    </button>
                    <button type="button" class="btn btn-cyh-outline btn-sm" onclick="downloadAiBannerPng()">
                        <i class="bi bi-download me-1"></i>Download PNG
                    </button>
                    <button type="button" class="btn btn-cyh-teal btn-sm" onclick="saveToMyDesigns(false)">
                        <i class="bi bi-bookmark-check me-1"></i>Save Design
                    </button>
                    <button type="button" class="btn btn-cyh-primary btn-sm" onclick="saveToMyDesigns(true)">
                        <i class="bi bi-pencil-square me-1"></i>Open in Editor
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
const _token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
let currentAiStyle = 'Modern';
let generatedData = null;
let currentZoom = 1.0;

// Curated 1-Click Campaigns for Auto-Generation (Including Indian Calendar & Festivals)
const AUTO_CAMPAIGNS = [
    { topic: 'Heart Health & Blood Pressure: 3 Proven Rules', style: 'Modern', lang: 'English', orient: 'Square' },
    { topic: 'Diabetes Management & Sugar Control Habits', style: 'Minimal', lang: 'English', orient: 'Square' },
    { topic: 'National Doctor\'s Day: Honoring Healers & Preventive Health Checkups', style: 'Modern', lang: 'English', orient: 'Square' },
    { topic: 'International Yoga Day: Daily Asanas, Pranayama & Mental Peace', style: 'Modern', lang: 'English', orient: 'Square' },
    { topic: 'World Blood Donor Day: Give Blood, Save Precious Lives', style: 'Modern', lang: 'English', orient: 'Square' },
    { topic: 'Safe & Healthy Green Diwali: Clean Lungs, Burn Care & Sugar Control', style: 'Colorful', lang: 'English', orient: 'Square' },
    { topic: 'Monsoon Flu & Waterborne Disease Prevention', style: 'Modern', lang: 'English', orient: 'Square' },
    { topic: 'Healthy Daily Nutrition & Clean Eating Plate', style: 'Colorful', lang: 'English', orient: 'Square' },
    { topic: 'Child Vaccination & Physical Growth Milestones', style: 'Minimal', lang: 'English', orient: 'Square' },
    { topic: 'Preventing Digital Eye Strain & 20-20-20 Rule', style: 'Professional', lang: 'English', orient: 'Square' },
    { topic: 'National Dengue Day: Stopping Mosquito Breeding & Platelet Care', style: 'Professional', lang: 'English', orient: 'Square' },
    { topic: 'Swasth Bharat: National Health, Hygiene & Wellness Pledge', style: 'Modern', lang: 'English', orient: 'Square' },
    { topic: 'हृदय स्वास्थ्य और उच्च रक्तचाप से बचाव के उपाय', style: 'Modern', lang: 'Hindi', orient: 'Square' },
    { topic: 'मधुमेह नियंत्रण और संतुलित खानपान के नियम', style: 'Colorful', lang: 'Hindi', orient: 'Square' },
    { topic: 'राष्ट्रीय डॉक्टर दिवस: स्वास्थ्य रक्षक और नियमित स्वास्थ्य जांच', style: 'Modern', lang: 'Hindi', orient: 'Square' },
    { topic: 'अंतर्राष्ट्रीय योग दिवस: प्राणायाम और तनाव मुक्ति के सरल नियम', style: 'Modern', lang: 'Hindi', orient: 'Square' },
    { topic: 'दीपावली स्वास्थ्य सुरक्षा: मधुमेह अनुकूल मिठाई और प्रदूषण से बचाव', style: 'Colorful', lang: 'Hindi', orient: 'Square' },
    { topic: 'डेंगू और संक्रामक बुखार से बचाव के जरूरी उपाय', style: 'Professional', lang: 'Hindi', orient: 'Square' }
];

function instantAutoGenerate(presetIdx = null) {
    let item;
    if (presetIdx !== null && presetIdx !== undefined && presetIdx >= 0 && presetIdx < AUTO_CAMPAIGNS.length) {
        item = AUTO_CAMPAIGNS[presetIdx];
    } else {
        const randIdx = Math.floor(Math.random() * AUTO_CAMPAIGNS.length);
        item = AUTO_CAMPAIGNS[randIdx];
    }

    // Set topic
    document.getElementById('aiTopic').value = item.topic;

    // Reset topic chips active styling
    document.querySelectorAll('.topic-chip').forEach(b => {
        b.classList.remove('btn-teal', 'text-white');
        b.classList.add('btn-outline-secondary');
        b.style.backgroundColor = '';
        b.style.borderColor = '';
    });

    // Set language
    const langSelect = document.getElementById('aiLanguage');
    if (langSelect) langSelect.value = item.lang;

    // Set orientation
    const orientSelect = document.getElementById('aiOrientation');
    if (orientSelect) orientSelect.value = item.orient;

    // Set style
    setAiStyleByName(item.style);

    // Trigger AI Generation immediately
    triggerAiGeneration();
}

function shuffleTopic() {
    const rand = AUTO_CAMPAIGNS[Math.floor(Math.random() * AUTO_CAMPAIGNS.length)];
    const el = document.getElementById('aiTopic');
    el.value = rand.topic;
    el.focus();
}

function setAiStyleByName(styleName) {
    currentAiStyle = styleName;
    document.querySelectorAll('.style-card').forEach(c => {
        c.style.border = '1px solid #E2E8F0';
        c.style.background = '#FFFFFF';
        if (c.getAttribute('onclick')?.includes(`'${styleName}'`)) {
            c.style.border = '2px solid #0EA5A0';
            c.style.background = '#F0FDFA';
        }
    });
}

function selectTopic(btn, topic) {
    document.querySelectorAll('.topic-chip').forEach(b => {
        b.classList.remove('btn-teal', 'text-white');
        b.classList.add('btn-outline-secondary');
    });
    btn.classList.remove('btn-outline-secondary');
    btn.classList.add('btn-teal', 'text-white');
    btn.style.backgroundColor = '#0EA5A0';
    btn.style.borderColor = '#0EA5A0';
    document.getElementById('aiTopic').value = topic;
}

function selectStyle(el, styleName) {
    currentAiStyle = styleName;
    document.querySelectorAll('.style-card').forEach(c => {
        c.style.border = '1px solid #E2E8F0';
        c.style.background = '#FFFFFF';
    });
    el.style.border = '2px solid #0EA5A0';
    el.style.background = '#F0FDFA';
}

async function triggerAiGeneration() {
    const topic = document.getElementById('aiTopic').value.trim();
    if (!topic) {
        alert('Please enter a medical topic or click one of the quick topic chips.');
        document.getElementById('aiTopic').focus();
        return;
    }

    const btn = document.getElementById('btnGenerate');
    const btnText = document.getElementById('btnGenText');
    const emptyState = document.getElementById('aiEmptyState');
    const loadingState = document.getElementById('aiLoadingState');
    const canvasWrapper = document.getElementById('aiCanvasWrapper');
    const controls = document.getElementById('previewControls');
    const actionBar = document.getElementById('aiActionBar');
    const statusBadge = document.getElementById('previewStatusBadge');

    // UI Loading state
    btn.disabled = true;
    btnText.textContent = 'Generating with AI...';
    emptyState.style.display = 'none';
    canvasWrapper.style.display = 'none';
    loadingState.style.display = 'block';
    statusBadge.textContent = 'Processing...';
    statusBadge.className = 'badge rounded-pill bg-warning text-dark border ms-2';

    const reqBody = {
        Topic: topic,
        Style: currentAiStyle,
        Language: document.getElementById('aiLanguage').value,
        Orientation: document.getElementById('aiOrientation').value,
        IncludeBranding: document.getElementById('chkIncludeBranding').checked
    };

    try {
        const res = await fetch('/AiBanner/Generate', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': _token
            },
            body: JSON.stringify(reqBody)
        });

        const json = await res.json();
        if (!json.isSuccess || !json.data) {
            alert(json.msg || 'Could not generate banner. Please try again.');
            loadingState.style.display = 'none';
            emptyState.style.display = 'block';
            statusBadge.textContent = 'Failed';
            return;
        }

        generatedData = json.data;
        renderGeneratedBanner(generatedData);

        loadingState.style.display = 'none';
        canvasWrapper.style.display = 'block';
        controls.style.setProperty('display', 'flex', 'important');
        actionBar.style.setProperty('display', 'flex', 'important');
        const bgToolbar = document.getElementById('aiBgToolbar');
        if (bgToolbar) bgToolbar.style.setProperty('display', 'flex', 'important');
        statusBadge.textContent = 'Completed';
        statusBadge.className = 'badge rounded-pill bg-success text-white border ms-2';

    } catch (e) {
        console.error("AI Generation error:", e);
        alert('Network or server error while generating banner.');
        loadingState.style.display = 'none';
        emptyState.style.display = 'block';
    } finally {
        btn.disabled = false;
        btnText.textContent = 'Generate Branded Banner with AI';
    }
}

function changeCanvasBg(newBg) {
    if (!generatedData) return;
    generatedData.bgColor = newBg;
    generatedData.BgColor = newBg;

    const rawJson = generatedData.designJson || generatedData.DesignJson;
    if (rawJson) {
        try {
            let parsed = typeof rawJson === 'string' ? JSON.parse(rawJson) : rawJson;
            while (typeof parsed === 'string') parsed = JSON.parse(parsed);
            if (parsed && typeof parsed === 'object') {
                parsed.bg = newBg;
                generatedData.designJson = JSON.stringify(parsed);
                generatedData.DesignJson = generatedData.designJson;
            }
        } catch (e) {
            console.warn("Could not update bg in designJson:", e);
        }
    }
    renderGeneratedBanner(generatedData);
}

function renderGeneratedBanner(data) {
    const canvas = document.getElementById('aiCanvas');
    if (!canvas || !data) return;

    const W = data.widthPx || data.WidthPx || 1080;
    const H = data.heightPx || data.HeightPx || 1080;
    const orient = data.orientation || data.Orientation || 'Square';
    canvas.width = W;
    canvas.height = H;

    const dimLabel = document.getElementById('canvasDimInfo');
    if (dimLabel) dimLabel.textContent = `${W} × ${H} px (${orient})`;

    const ctx = canvas.getContext('2d');
    let elements = [];
    let bg = data.bgColor || data.BgColor || '#0B1B3D';

    const rawJson = data.designJson || data.DesignJson;
    if (rawJson) {
        try {
            let parsed = typeof rawJson === 'string' ? JSON.parse(rawJson) : rawJson;
            while (typeof parsed === 'string') {
                parsed = JSON.parse(parsed);
            }
            if (parsed && typeof parsed === 'object') {
                if (parsed.bg) bg = parsed.bg;
                if (parsed.elements && Array.isArray(parsed.elements)) elements = parsed.elements;
            }
        } catch (e) {
            console.warn("Could not parse DesignJson:", e);
        }
    }

    // Render Canvas
    ctx.clearRect(0, 0, W, H);

    const isLightBg = typeof bg === 'string' && !bg.startsWith('gradient:') && (bg.toLowerCase() === '#f8fafc' || bg.toLowerCase() === '#ffffff' || bg.toLowerCase() === '#fff');

    // Fill background (supports gradient or solid color)
    if (typeof bg === 'string' && bg.startsWith('gradient:')) {
        const gradType = bg.split(':')[1];
        let grad = ctx.createLinearGradient(0, 0, W, H);
        if (gradType === 'teal-navy') {
            grad.addColorStop(0, '#091E42');
            grad.addColorStop(0.5, '#1B2B6B');
            grad.addColorStop(1, '#0EA5A0');
        } else if (gradType === 'emerald-gold') {
            grad.addColorStop(0, '#064E3B');
            grad.addColorStop(0.5, '#047857');
            grad.addColorStop(1, '#065F46');
        } else if (gradType === 'midnight-purple') {
            grad.addColorStop(0, '#0F172A');
            grad.addColorStop(0.5, '#1E1B4B');
            grad.addColorStop(1, '#312E81');
        } else if (gradType === 'crimson-dark') {
            grad.addColorStop(0, '#4C0519');
            grad.addColorStop(0.5, '#831843');
            grad.addColorStop(1, '#1E1B4B');
        } else {
            grad.addColorStop(0, '#0F172A');
            grad.addColorStop(1, '#1E293B');
        }
        ctx.fillStyle = grad;
    } else {
        ctx.fillStyle = bg || '#0B1B3D';
    }
    ctx.fillRect(0, 0, W, H);

    elements.forEach(el => {
        ctx.save();
        ctx.globalAlpha = el.opacity ?? 1;

        if (el.type === 'rect') {
            let col = el.color || '#0EA5A0';
            if (isLightBg && (col === '#162A5A' || col === '#152852' || col === '#1E293B' || col === '#0B1B3D')) {
                col = '#FFFFFF';
            }
            ctx.fillStyle = col;
            roundRect(ctx, el.x, el.y, el.w, el.h, 16);
            ctx.fill();
            if (isLightBg && col === '#FFFFFF') {
                ctx.strokeStyle = '#CBD5E1';
                ctx.lineWidth = 2;
                ctx.stroke();
            }
        } else if (el.type === 'circle') {
            ctx.beginPath();
            ctx.ellipse(el.x + el.w / 2, el.y + el.h / 2, el.w / 2, el.h / 2, 0, 0, Math.PI * 2);
            ctx.fillStyle = el.color || '#0EA5A0';
            ctx.fill();
        } else if (el.type === 'text') {
            let textColor = el.color || '#FFFFFF';
            if (isLightBg && (textColor.toLowerCase() === '#ffffff' || textColor.toLowerCase() === '#fff')) {
                textColor = '#0F172A';
            }
            const weight = el.bold ? 'bold ' : '';
            ctx.font = `${weight}${el.size || 30}px ${el.font || 'sans-serif'}`;
            ctx.fillStyle = textColor;
            ctx.textAlign = el.align || 'left';
            ctx.textBaseline = 'top';

            const words = (el.text || '').split(' ');
            let line = '';
            let cy = el.y;
            const maxW = el.w || (W - el.x);
            const lineH = (el.size || 30) * 1.28;

            for (let n = 0; n < words.length; n++) {
                const test = line + words[n] + ' ';
                if (ctx.measureText(test).width > maxW && n > 0) {
                    ctx.fillText(line, el.align === 'center' ? (el.x + el.w / 2) : el.x, cy);
                    line = words[n] + ' ';
                    cy += lineH;
                } else {
                    line = test;
                }
            }
            ctx.fillText(line, el.align === 'center' ? (el.x + el.w / 2) : el.x, cy);
        }
        ctx.restore();
    });

    resetAiZoom();
}

function roundRect(ctx, x, y, width, height, radius) {
    ctx.beginPath();
    ctx.moveTo(x + radius, y);
    ctx.lineTo(x + width - radius, y);
    ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
    ctx.lineTo(x + width, y + height - radius);
    ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
    ctx.lineTo(x + radius, y + height);
    ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
    ctx.lineTo(x, y + radius);
    ctx.quadraticCurveTo(x, y, x + radius, y);
    ctx.closePath();
}

// Zoom controls
function zoomAiPreview(delta) {
    currentZoom = Math.min(Math.max(0.3, currentZoom + delta), 2.5);
    updateAiZoom();
}
function resetAiZoom() {
    currentZoom = 1.0;
    updateAiZoom();
}
function updateAiZoom() {
    const wrapper = document.getElementById('aiCanvasWrapper');
    const label = document.getElementById('aiZoomLabel');
    if (wrapper) wrapper.style.transform = `scale(${currentZoom})`;
    if (label) label.textContent = `${Math.round(currentZoom * 100)}%`;
}

// Download
function downloadAiBannerPng() {
    const canvas = document.getElementById('aiCanvas');
    if (!canvas) return;
    const link = document.createElement('a');
    const title = (generatedData?.designName || generatedData?.DesignName || 'ai-banner').replace(/[^a-zA-Z0-9_-]/g, '_');
    link.download = `${title}.png`;
    link.href = canvas.toDataURL('image/png');
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}

// Save to DB and Optionally Open in Editor
async function saveToMyDesigns(openInEditor) {
    if (!generatedData) return;
    const canvas = document.getElementById('aiCanvas');
    const thumb = canvas.toDataURL('image/jpeg', 0.8);

    const rawJson = generatedData.designJson || generatedData.DesignJson;
    const rawName = generatedData.designName || generatedData.DesignName || (document.getElementById('aiTopic')?.value || 'AI Generated Banner');
    const rawOrient = generatedData.orientation || generatedData.Orientation || 'Square';
    const rawW = generatedData.widthPx || generatedData.WidthPx || 1080;
    const rawH = generatedData.heightPx || generatedData.HeightPx || 1080;

    let dJsonStr = rawJson;
    if (typeof dJsonStr === 'object') dJsonStr = JSON.stringify(dJsonStr);

    const body = {
        DesignName: rawName,
        DesignJson: dJsonStr,
        ThumbnailPath: thumb,
        Status: 'Saved',
        Orientation: rawOrient,
        WidthPx: rawW,
        HeightPx: rawH
    };

    try {
        const res = await fetch('/AiBanner/SaveDesign', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': _token
            },
            body: JSON.stringify(body)
        });

        const data = await res.json();
        if (data.isSuccess && data.encId) {
            if (openInEditor) {
                window.location.href = `/Design/Edit/${data.encId}`;
            } else {
                alert('Success! Banner has been saved to "My Designs".');
            }
        } else {
            alert(data.msg || 'Could not save banner.');
        }
    } catch (e) {
        alert('Network error while saving banner.');
    }
}

function switchTopicTab(tab) {
    const generalChips = document.getElementById('chipsGeneral');
    const indianChips = document.getElementById('chipsIndian');
    const tabGen = document.getElementById('tabGeneral');
    const tabInd = document.getElementById('tabIndian');

    if (tab === 'indian') {
        if (generalChips) generalChips.style.setProperty('display', 'none', 'important');
        if (indianChips) indianChips.style.setProperty('display', 'flex', 'important');
        if (tabGen) { tabGen.classList.remove('active', 'fw-bold', 'text-teal'); tabGen.classList.add('text-secondary', 'fw-semibold'); tabGen.style.color = ''; }
        if (tabInd) { tabInd.classList.remove('text-secondary', 'fw-semibold'); tabInd.classList.add('active', 'fw-bold', 'text-teal'); tabInd.style.color = '#0EA5A0'; }
    } else {
        if (indianChips) indianChips.style.setProperty('display', 'none', 'important');
        if (generalChips) generalChips.style.setProperty('display', 'flex', 'important');
        if (tabInd) { tabInd.classList.remove('active', 'fw-bold', 'text-teal'); tabInd.classList.add('text-secondary', 'fw-semibold'); tabInd.style.color = ''; }
        if (tabGen) { tabGen.classList.remove('text-secondary', 'fw-semibold'); tabGen.classList.add('active', 'fw-bold', 'text-teal'); tabGen.style.color = '#0EA5A0'; }
    }
}

// Auto-populate from URL query params (e.g. from /Calendar 1-click links)
window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const preTopic = urlParams.get('topic');
    const preLang = urlParams.get('lang');
    if (preTopic) {
        document.getElementById('aiTopic').value = preTopic;
        if (preLang) {
            const langSelect = document.getElementById('aiLanguage');
            if (langSelect) langSelect.value = preLang;
        }
        setTimeout(() => {
            triggerAiGeneration();
        }, 300);
    }
});
</script>
}
