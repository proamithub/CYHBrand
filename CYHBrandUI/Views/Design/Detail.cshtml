@model CYHBrandModel.DTO.BannerDesignDTO
@{
    ViewData["Title"] = Model?.DesignName ?? "Design Detail";
}

<div class="p-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back
        </a>
        <h4 class="fw-bold mb-0">@Model?.DesignName</h4>
        <span class="badge @(Model?.Status == "Published" ? "bg-success" : Model?.Status == "Saved" ? "bg-info" : "bg-secondary")">
            @Model?.Status
        </span>
    </div>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-center p-5">
                    @if (!string.IsNullOrEmpty(Model?.ThumbnailPath))
                    {
                        <img src="@Model.ThumbnailPath" class="img-fluid rounded" style="max-height:500px" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center rounded"
                             style="width:400px;height:400px;background:#f1f5f9">
                            <i class="bi bi-image text-muted" style="font-size:4rem"></i>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-semibold mb-3">Design Info</h6>
                    <dl class="row small mb-0">
                        <dt class="col-6 text-muted">Status</dt>
                        <dd class="col-6">@Model?.Status</dd>
                        <dt class="col-6 text-muted">Orientation</dt>
                        <dd class="col-6">@(Model?.Orientation ?? "—")</dd>
                        <dt class="col-6 text-muted">Size</dt>
                        <dd class="col-6">@Model?.WidthPx × @Model?.HeightPx px</dd>
                        <dt class="col-6 text-muted">Created</dt>
                        <dd class="col-6">@Model?.CreatedDate?.ToString("dd MMM yyyy")</dd>
                        <dt class="col-6 text-muted">Updated</dt>
                        <dd class="col-6">@(Model?.UpdatedDate?.ToString("dd MMM yyyy") ?? "—")</dd>
                    </dl>
                </div>
            </div>

            <div class="d-grid gap-2">
                <a asp-action="Edit" asp-route-id="@Model?.EncId"
                   class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i> Edit Design
                </a>
                @if (Model?.Status != "Published")
                {
                    <button class="btn btn-success" onclick="updateStatus('@Model?.EncId','Published')">
                        <i class="bi bi-send me-1"></i> Publish
                    </button>
                }
                @if (!string.IsNullOrEmpty(Model?.ExportedFilePath))
                {
                    <a href="@Model.ExportedFilePath" download class="btn btn-outline-info">
                        <i class="bi bi-download me-1"></i> Download
                    </a>
                }
                <button class="btn btn-outline-danger" onclick="deleteThis('@Model?.EncId')">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()
@section Scripts {
<script>
const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

async function updateStatus(encId, status) {
    await fetch('/Design/UpdateStatus', {
        method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded','RequestVerificationToken': token},
        body: `id=${encId}&status=${status}`
    });
    location.reload();
}
async function deleteThis(encId) {
    if (!confirm('Delete this design?')) return;
    const res = await fetch('/Design/Delete', {
        method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded','RequestVerificationToken': token},
        body: 'id=' + encId
    });
    const d = await res.json();
    if (d.isSuccess) window.location.href = '/Design';
    else alert(d.msg || 'Error');
}
</script>
}
