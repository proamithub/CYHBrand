<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CYHBrand</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var isAuth = User?.Identity?.IsAuthenticated == true;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var doctorName = User?.Claims?.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.GivenName)?.Value
                  ?? User?.Claims?.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Name)?.Value
                  ?? "Doctor";
}
@if (isAuth)
{
    <!-- Sidebar -->
    <div class="cyh-sidebar" id="cyhSidebar">
        <div class="cyh-sidebar-brand">
            <div class="cyh-logo-wrap">
                <i class="bi bi-heart-pulse-fill"></i>
            </div>
            <div>
                <div class="cyh-brand-name">CYHBrand</div>
                <div class="cyh-brand-sub">Doctor Branding Studio</div>
            </div>
        </div>

        <div class="cyh-sidebar-section">MAIN</div>
        <nav class="cyh-nav">
            <a class="cyh-nav-link @(currentController=="Home"?"active":"")" asp-controller="Home" asp-action="Index">
                <span class="cyh-nav-icon"><i class="bi bi-speedometer2"></i></span>
                <span class="cyh-nav-text">Dashboard</span>
            </a>
            <a class="cyh-nav-link @(currentController=="Doctor" && currentAction=="Profile"?"active":"")" asp-controller="Doctor" asp-action="Profile">
                <span class="cyh-nav-icon"><i class="bi bi-person-badge"></i></span>
                <span class="cyh-nav-text">My Profile</span>
            </a>
            <a class="cyh-nav-link @(currentController=="AiBanner"?"active":"")" asp-controller="AiBanner" asp-action="Index">
                <span class="cyh-nav-icon"><i class="bi bi-stars"></i></span>
                <span class="cyh-nav-text">AI Banner Creator</span>
            </a>
            <a class="cyh-nav-link @(currentController=="Template"?"active":"")" asp-controller="Template" asp-action="Index">
                <span class="cyh-nav-icon"><i class="bi bi-grid-1x2"></i></span>
                <span class="cyh-nav-text">Template Library</span>
            </a>
            <a class="cyh-nav-link @(currentController=="Design" && currentAction!="Index"?"active":"")" asp-controller="Design" asp-action="Create">
                <span class="cyh-nav-icon"><i class="bi bi-pencil-square"></i></span>
                <span class="cyh-nav-text">Banner Editor</span>
            </a>

            <div class="cyh-sidebar-section">CONTENT</div>
            <a class="cyh-nav-link @(currentController=="Calendar"?"active":"")" asp-controller="Calendar" asp-action="Index">
                <span class="cyh-nav-icon"><i class="bi bi-calendar3"></i></span>
                <span class="cyh-nav-text">Content Calendar</span>
            </a>
            <a class="cyh-nav-link @(currentController=="Design" && currentAction=="Index"?"active":"")" asp-controller="Design" asp-action="Index">
                <span class="cyh-nav-icon"><i class="bi bi-images"></i></span>
                <span class="cyh-nav-text">My Designs</span>
            </a>
            <a class="cyh-nav-link @(currentController=="Share"?"active":"")" asp-controller="Share" asp-action="Index">
                <span class="cyh-nav-icon"><i class="bi bi-share"></i></span>
                <span class="cyh-nav-text">Share &amp; Publish</span>
            </a>

            <div class="cyh-sidebar-section">ACCOUNT</div>
            <a class="cyh-nav-link @(currentController=="Connected"?"active":"")" asp-controller="Connected" asp-action="Index">
                <span class="cyh-nav-icon"><i class="bi bi-plug"></i></span>
                <span class="cyh-nav-text">Connected Accounts</span>
            </a>
            <a class="cyh-nav-link @(currentController=="Usage"?"active":"")" asp-controller="Usage" asp-action="Index">
                <span class="cyh-nav-icon"><i class="bi bi-bar-chart-line"></i></span>
                <span class="cyh-nav-text">Usage &amp; Subscription</span>
            </a>
            <a class="cyh-nav-link @(currentController=="Settings"?"active":"")" asp-controller="Settings" asp-action="Index">
                <span class="cyh-nav-icon"><i class="bi bi-gear"></i></span>
                <span class="cyh-nav-text">Settings</span>
            </a>
            <a class="cyh-nav-link @(currentController=="Help"?"active":"")" asp-controller="Help" asp-action="Index">
                <span class="cyh-nav-icon"><i class="bi bi-question-circle"></i></span>
                <span class="cyh-nav-text">Help &amp; Support</span>
            </a>
        </nav>

        <!-- Logout at bottom -->
        <div class="cyh-sidebar-footer">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="cyh-logout-btn">
                    <span class="cyh-nav-icon"><i class="bi bi-box-arrow-left"></i></span>
                    <span class="cyh-nav-text">Logout</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Top Navigation -->
    <div class="cyh-topnav">
        <div class="d-flex align-items-center gap-3">
            <button class="cyh-mobile-toggle d-lg-none" id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>
            <div>
                <div class="cyh-page-title">@ViewData["Title"]</div>
                @if (ViewData["PageSubtitle"] != null)
                {
                    <div class="cyh-page-subtitle">@ViewData["PageSubtitle"]</div>
                }
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <!-- Date -->
            <div class="cyh-topnav-date d-none d-md-block">
                <i class="bi bi-calendar3 me-1"></i>
                <span id="currentDate"></span>
            </div>
            <!-- Notifications -->
            <button class="cyh-icon-btn position-relative">
                <i class="bi bi-bell"></i>
                <span class="cyh-notif-dot"></span>
            </button>
            <!-- Profile Dropdown -->
            <div class="dropdown">
                <button class="cyh-profile-btn dropdown-toggle" data-bs-toggle="dropdown">
                    <div class="cyh-profile-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="d-none d-md-block text-start">
                        <div class="cyh-profile-name">@doctorName</div>
                        <div class="cyh-profile-role">Doctor</div>
                    </div>
                </button>
                <ul class="dropdown-menu dropdown-menu-end cyh-profile-menu">
                    <li><a class="dropdown-item" asp-controller="Doctor" asp-action="Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                    <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear me-2"></i>Settings</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Toast container -->
    <div class="position-fixed top-0 end-0 p-3" style="z-index:9999" id="toastContainer">
        @if (TempData["SuccessMsg"] != null)
        {
            <div class="toast align-items-center text-bg-success border-0 show" role="alert">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-check-circle me-2"></i>@TempData["SuccessMsg"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMsg"] != null)
        {
            <div class="toast align-items-center text-bg-danger border-0 show" role="alert">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMsg"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
    </div>

    <!-- Main Content -->
    <div class="cyh-main">
        @RenderBody()
    </div>

    <!-- Mobile Overlay -->
    <div class="cyh-overlay d-lg-none" id="sidebarOverlay"></div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Date in topnav
    const dateEl = document.getElementById('currentDate');
    if (dateEl) {
        const now = new Date();
        dateEl.textContent = now.toLocaleDateString('en-IN', { weekday:'short', day:'2-digit', month:'short', year:'numeric' });
    }
    // Mobile sidebar toggle
    const toggle = document.getElementById('sidebarToggle');
    const sidebar = document.getElementById('cyhSidebar');
    const overlay = document.getElementById('sidebarOverlay');
    if (toggle) {
        toggle.addEventListener('click', () => {
            sidebar.classList.toggle('open');
            overlay.classList.toggle('show');
        });
        overlay.addEventListener('click', () => {
            sidebar.classList.remove('open');
            overlay.classList.remove('show');
        });
    }
    // Auto-dismiss toasts
    document.querySelectorAll('.toast').forEach(t => {
        setTimeout(() => { t.classList.remove('show'); }, 4000);
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
