@model CYHBrandModel.DTO.BannerTemplateDTO
@{
    ViewData["Title"] = "Doctor Banner Templates";
    var activeCategory = Model?.CategoryId.HasValue == true ? Model.CategoryId.Value.ToString() : "";
    var currentOrientation = Model?.Orientation ?? "";
}

<div class="container-fluid px-3 px-md-4 py-3">

    <!-- ── HEADER HERO SECTION ── -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" 
         style="background: linear-gradient(135deg, #0B1B3D 0%, #152852 60%, #0EA5A0 100%); color: #fff;">
        <div class="card-body p-4 p-md-5 position-relative">
            <div class="row align-items-center position-relative" style="z-index: 2;">
                <div class="col-lg-8">
                    <span class="badge bg-teal bg-opacity-25 text-white border border-light border-opacity-25 px-3 py-1 rounded-pill mb-2 small">
                        <i class="bi bi-patch-check-fill text-warning me-1"></i> Professionally Curated Medical Templates
                    </span>
                    <h2 class="fw-bold mb-2 display-6 text-white">Clinical Post &amp; Banner Library</h2>
                    <p class="mb-3 opacity-80 lead fs-6" style="max-width: 650px;">
                        Select high-converting doctor templates for patient awareness, festival greetings, seasonal alerts, and OPD schedules. Customize in 1-click with your verified clinic details.
                    </p>
                    <div class="d-flex flex-wrap gap-2 pt-1">
                        <span class="badge bg-white bg-opacity-15 text-white px-3 py-2 rounded-pill small">
                            <i class="bi bi-grid-fill me-1"></i> @(Model?.TotalRecords ?? 0) Medical Presets
                        </span>
                        <span class="badge bg-white bg-opacity-15 text-white px-3 py-2 rounded-pill small">
                            <i class="bi bi-palette-fill me-1"></i> Multi-Format (Square, Story, Banner)
                        </span>
                        <span class="badge bg-white bg-opacity-15 text-white px-3 py-2 rounded-pill small">
                            <i class="bi bi-lightning-charge-fill text-warning me-1"></i> 100% Free for Verified Doctors
                        </span>
                    </div>
                </div>
                <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                    <a asp-controller="AiBanner" asp-action="Index" class="btn btn-warning btn-lg rounded-pill px-4 shadow fw-bold text-dark">
                        <i class="bi bi-stars me-1"></i> Generate with AI
                    </a>
                </div>
            </div>
            <!-- Decorative circle -->
            <div class="position-absolute end-0 bottom-0 opacity-10 pointer-events-none" style="transform: translate(20%, 30%);">
                <i class="bi bi-heart-pulse-fill" style="font-size: 20rem; color: #fff;"></i>
            </div>
        </div>
    </div>

    <!-- ── CATEGORY PILLS BAR ── -->
    <div class="d-flex align-items-center gap-2 overflow-auto pb-3 mb-3 border-bottom no-scrollbar" style="white-space: nowrap;">
        <a asp-action="Index" 
           asp-route-orientation="@currentOrientation"
           asp-route-searchKey="@Model?.SearchKey"
           class="btn btn-sm rounded-pill px-3 py-2 text-nowrap fw-medium @(string.IsNullOrEmpty(activeCategory) ? "btn-primary shadow-sm" : "btn-light border text-dark")">
            <i class="bi bi-stars me-1"></i> All Templates
        </a>

        @if (Model?.CategoryList != null)
        {
            foreach (var cat in Model.CategoryList)
            {
                var isSelected = (Model?.CategoryId.HasValue == true && Model.CategoryId.Value == cat.CategoryId);
                var icon = cat.Slug?.Contains("cardio") == true ? "heart-pulse-fill" :
                           cat.Slug?.Contains("diabetes") == true ? "droplet-half" :
                           cat.Slug?.Contains("pediatric") == true ? "balloon-fill" :
                           cat.Slug?.Contains("festival") == true ? "stars" :
                           cat.Slug?.Contains("aware") == true ? "shield-exclamation" :
                           cat.Slug?.Contains("announce") == true ? "megaphone-fill" :
                           cat.Slug?.Contains("promot") == true ? "tag-fill" : "hospital-fill";

                <a asp-action="Index" 
                   asp-route-categoryId="@cat.EncId"
                   asp-route-orientation="@currentOrientation"
                   asp-route-searchKey="@Model?.SearchKey"
                   class="btn btn-sm rounded-pill px-3 py-2 text-nowrap fw-medium @(isSelected ? "btn-primary shadow-sm" : "btn-light border text-dark")">
                    <i class="bi bi-@icon me-1 text-teal"></i> @cat.CategoryName
                </a>
            }
        }
    </div>

    <!-- ── SEARCH & ORIENTATION FILTER BAR ── -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                @if (Model?.CategoryId.HasValue == true)
                {
                    <input type="hidden" name="categoryId" value="@Model.CategoryId.Value" />
                }

                <!-- Search Input -->
                <div class="col-12 col-md-5 col-lg-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="searchKey" value="@Model?.SearchKey" 
                               class="form-control bg-light border-start-0 rounded-end-pill py-2 shadow-none" 
                               placeholder="Search topics (e.g. Heart, Sugar, Dengue, Dental, Festival)..." />
                    </div>
                </div>

                <!-- Orientation Selector -->
                <div class="col-6 col-md-3 col-lg-3">
                    <select name="orientation" class="form-select rounded-pill py-2 shadow-none bg-light">
                        <option value="">All Formats &amp; Sizes</option>
                        <option value="Square" selected="@(currentOrientation == "Square")">Square (1:1 • 1080×1080)</option>
                        <option value="Portrait" selected="@(currentOrientation == "Portrait")">Portrait / Story (9:16 • 1080×1920)</option>
                        <option value="Landscape" selected="@(currentOrientation == "Landscape")">Landscape (16:9 • 1920×1080)</option>
                    </select>
                </div>

                <!-- Submit / Clear Buttons -->
                <div class="col-6 col-md-4 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 flex-grow-1 shadow-sm">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    @if (!string.IsNullOrEmpty(Model?.SearchKey) || Model?.CategoryId.HasValue == true || !string.IsNullOrEmpty(Model?.Orientation))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3" title="Clear Filters">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- ── TEMPLATE GALLERY GRID ── -->
    @if (Model?.TemplateList?.Any() == true)
    {
        <div class="row g-4 mb-4">
            @foreach (var t in Model.TemplateList)
            {
                var isStory = t.Orientation == "Portrait";
                var isBanner = t.Orientation == "Landscape";
                var aspectStyle = isStory ? "aspect-ratio: 9/16; max-height: 400px;" :
                                  isBanner ? "aspect-ratio: 16/9;" : "aspect-ratio: 1/1;";
                var previewUrl = Url.Action("Preview", "Template", new { id = t.EncId ?? t.TemplateId.ToString() });

                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden template-card-item position-relative" 
                         style="transition: transform 0.2s, box-shadow 0.2s; background: #fff;">

                        <!-- Thumbnail & Badges Container -->
                        <div class="position-relative overflow-hidden d-flex align-items-center justify-content-center cursor-pointer template-stage-box" 
                             style="@aspectStyle; background: #071126;"
                             data-name="@t.TemplateName"
                             data-img="@t.ThumbnailPath"
                             data-cat="@(t.CategoryName ?? "Clinical Care")"
                             data-orient="@(t.Orientation ?? "Square")"
                             data-dims="@(t.WidthPx) × @(t.HeightPx) px"
                             data-id="@(t.EncId ?? t.TemplateId.ToString())"
                             data-desc="@(t.Description ?? "Professional medical awareness banner ready for clinic branding.")"
                             data-preview-url="@previewUrl">

                            @if (!string.IsNullOrEmpty(t.ThumbnailPath))
                            {
                                <img src="@t.ThumbnailPath" alt="@t.TemplateName" class="w-100 h-100 template-thumb-img" style="object-fit: contain; display: block;" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center text-white p-3 text-center"
                                     style="background: linear-gradient(135deg, #1B2B6B 0%, #0EA5A0 100%);">
                                    <i class="bi bi-heart-pulse-fill fs-1 opacity-75 mb-2"></i>
                                    <span class="fw-bold fs-6">@t.TemplateName</span>
                                    <small class="opacity-75">@t.CategoryName</small>
                                </div>
                            }

                            <!-- Orientation Badge -->
                            <div class="position-absolute top-0 start-0 m-2 pointer-events-none" style="z-index: 3;">
                                <span class="badge bg-dark bg-opacity-75 backdrop-blur text-white px-2 py-1 rounded-pill small" style="font-size: 10px;">
                                    <i class="bi bi-aspect-ratio me-1"></i>@(t.Orientation ?? "Square")
                                </span>
                            </div>

                            <!-- PRO Badge -->
                            @if (t.IsPremium)
                            {
                                <div class="position-absolute top-0 end-0 m-2 pointer-events-none" style="z-index: 3;">
                                    <span class="badge bg-warning text-dark px-2 py-1 rounded-pill fw-bold shadow-sm" style="font-size: 10px;">
                                        <i class="bi bi-star-fill me-1"></i>PRO
                                    </span>
                                </div>
                            }

                            <!-- Hover Overlay with Actions -->
                            <div class="template-hover-overlay position-absolute inset-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center gap-2 p-3 opacity-0"
                                 style="background: rgba(11, 27, 61, 0.88); transition: opacity 0.25s ease; backdrop-filter: blur(3px); z-index: 4;">
                                
                                <button type="button" class="btn btn-light btn-sm rounded-pill px-3 shadow fw-semibold btn-quick-preview"
                                        data-name="@t.TemplateName"
                                        data-img="@t.ThumbnailPath"
                                        data-cat="@(t.CategoryName ?? "Clinical Care")"
                                        data-orient="@(t.Orientation ?? "Square")"
                                        data-dims="@(t.WidthPx) × @(t.HeightPx) px"
                                        data-id="@(t.EncId ?? t.TemplateId.ToString())"
                                        data-desc="@(t.Description ?? "Professional medical awareness banner ready for clinic branding.")"
                                        data-preview-url="@previewUrl">
                                    <i class="bi bi-eye-fill me-1 text-primary"></i> Quick Preview
                                </button>

                                <form asp-action="UseTemplate" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="templateId" value="@(t.EncId ?? t.TemplateId.ToString())" />
                                    <button type="submit" class="btn btn-teal btn-sm rounded-pill px-3 shadow fw-semibold text-white" style="background:#0EA5A0;">
                                        <i class="bi bi-pencil-square me-1"></i> Customize in Editor
                                    </button>
                                </form>

                                <a asp-controller="AiBanner" asp-action="Index" asp-route-topic="@t.TemplateName" class="btn btn-outline-light btn-sm rounded-pill px-3 fw-medium">
                                    <i class="bi bi-stars me-1 text-warning"></i> Generate with AI
                                </a>
                            </div>
                        </div>

                        <!-- Card Body Details -->
                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" style="font-size: 11px;">
                                        @(t.CategoryName ?? "Clinical Care")
                                    </span>
                                    <small class="text-muted" style="font-size: 11px;">
                                        <i class="bi bi-eye me-1"></i>@(t.UsageCount) uses
                                    </small>
                                </div>

                                <h6 class="fw-bold text-dark mb-1 text-truncate" title="@t.TemplateName">@t.TemplateName</h6>
                                <p class="text-muted small mb-3 text-truncate-2" style="font-size: 12px; min-height: 36px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @(string.IsNullOrWhiteSpace(t.Description) ? "Professional medical awareness poster ready for clinical branding." : t.Description)
                                </p>
                            </div>

                            <!-- Bottom Action Row -->
                            <div class="d-flex align-items-center gap-2 pt-2 border-top">
                                <a asp-action="Preview" asp-route-id="@(t.EncId ?? t.TemplateId.ToString())" class="btn btn-outline-secondary btn-sm rounded-pill flex-grow-1" style="font-size: 12px;">
                                    <i class="bi bi-eye me-1"></i> Details
                                </a>

                                <form asp-action="UseTemplate" method="post" class="flex-grow-1 m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="templateId" value="@(t.EncId ?? t.TemplateId.ToString())" />
                                    <button type="submit" class="btn btn-primary btn-sm rounded-pill w-100 shadow-sm" style="font-size: 12px;">
                                        <i class="bi bi-pencil me-1"></i> Use
                                    </button>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>

        <!-- ── PAGINATION ── -->
        @if (Model.TotalPages > 1)
        {
            <nav class="my-4">
                <ul class="pagination justify-content-center gap-1 mb-0">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        var isActive = (i == Model.PageNo);
                        <li class="page-item @(isActive ? "active" : "")">
                            <a class="page-link rounded-pill px-3 @(isActive ? "btn-primary text-white" : "border text-dark bg-white")"
                               asp-action="Index"
                               asp-route-pageNo="@i"
                               asp-route-searchKey="@Model.SearchKey"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-orientation="@Model.Orientation">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <!-- ── EMPTY STATE ── -->
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4">
            <div class="py-4">
                <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-search fs-1"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">No Templates Found</h5>
                <p class="text-muted small mb-4" style="max-width: 480px; margin: 0 auto;">
                    We couldn't find any medical templates matching your selected filter. Try clearing filters or create a custom banner with AI.
                </p>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-x-circle me-1"></i> Reset All Filters
                    </a>
                    <a asp-controller="AiBanner" asp-action="Index" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-stars me-1"></i> Generate with AI
                    </a>
                </div>
            </div>
        </div>
    }

</div>

<!-- ── QUICK PREVIEW MODAL ── -->
<div class="modal fade" id="quickPreviewModal" tabindex="-1" aria-labelledby="quickPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom px-4 py-3 bg-light">
                <div>
                    <h5 class="modal-title fw-bold text-dark" id="modalTemplateName">Template Preview</h5>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <span class="badge bg-primary-subtle text-primary border rounded-pill" id="modalCategoryBadge">Category</span>
                        <span class="badge bg-dark bg-opacity-75 text-white rounded-pill" id="modalOrientationBadge">1:1 Square</span>
                        <span class="badge bg-light text-muted border rounded-pill" id="modalDimensionsBadge">1080 × 1080 px</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 p-md-4 text-center bg-dark bg-opacity-25 d-flex align-items-center justify-content-center" style="min-height: 480px;">
                <div class="modal-preview-wrapper d-flex align-items-center justify-content-center w-100" style="max-height: 65vh;">
                    <img id="modalPreviewImg" src="" alt="Template" class="rounded-3 shadow-lg" 
                         style="max-height: 60vh; max-width: 100%; object-fit: contain; display: block; background: #071126;" />
                </div>
            </div>
            <div class="modal-footer border-top px-4 py-3 bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <p class="text-muted small mb-0 text-start" id="modalDescription" style="max-width: 380px; font-size: 12px;"></p>
                <div class="d-flex gap-2">
                    <a id="modalFullDetailsLink" href="#" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Full Details
                    </a>
                    <form asp-action="UseTemplate" method="post" id="modalUseForm" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="templateId" id="modalTemplateIdInput" value="" />
                        <button type="submit" class="btn btn-primary rounded-pill px-4 btn-sm shadow-sm fw-semibold">
                            <i class="bi bi-pencil-square me-1"></i> Customize in Editor
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<style>
    .template-card-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(15, 26, 66, 0.12) !important;
    }
    .template-card-item:hover .template-hover-overlay {
        opacity: 1 !important;
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .cursor-pointer {
        cursor: pointer;
    }
    .backdrop-blur {
        backdrop-filter: blur(4px);
    }
</style>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const modalEl = document.getElementById('quickPreviewModal');
        const modal = new bootstrap.Modal(modalEl);

        function triggerPreview(dataset) {
            document.getElementById('modalTemplateName').textContent = dataset.name || 'Template Preview';
            document.getElementById('modalCategoryBadge').textContent = dataset.cat || 'Clinical';
            document.getElementById('modalOrientationBadge').textContent = dataset.orient || 'Square';
            document.getElementById('modalDimensionsBadge').textContent = dataset.dims || '1080 × 1080 px';
            document.getElementById('modalPreviewImg').src = dataset.img || '';
            document.getElementById('modalTemplateIdInput').value = dataset.id || '';
            document.getElementById('modalDescription').textContent = dataset.desc || 'Clinically ready medical template for social posts.';
            document.getElementById('modalFullDetailsLink').href = dataset.previewUrl || '#';
            modal.show();
        }

        // Delegate click for buttons and stage boxes
        document.querySelectorAll('.btn-quick-preview').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                triggerPreview(this.dataset);
            });
        });

        document.querySelectorAll('.template-stage-box').forEach(function (box) {
            box.addEventListener('click', function (e) {
                // Ignore if clicked on a child button or form
                if (e.target.closest('button') || e.target.closest('form') || e.target.closest('a')) return;
                triggerPreview(this.dataset);
            });
        });
    });
</script>
}
