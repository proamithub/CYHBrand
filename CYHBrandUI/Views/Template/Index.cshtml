@model CYHBrandModel.DTO.BannerTemplateDTO
@{
    ViewData["Title"] = "Template Library";
    var activeCategory = Model?.CategoryId?.ToString();
    var activeOrientation = Model?.Orientation;
}

<div class="container-fluid px-3 px-md-4 py-3">

    <!-- ── TOP HEADER & BREADCRUMB ── -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                    <li class="breadcrumb-item active text-primary fw-medium" aria-current="page">Template Library</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-grid-1x2-fill text-primary"></i> Doctor Banner Template Library
            </h3>
            <p class="text-muted small mb-0 mt-1">Clinically vetted, ready-to-use medical posters and festival banners for your clinic and social media.</p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- Templates count badge -->
            <div class="badge bg-light text-dark border px-3 py-2 rounded-pill fs-7 d-flex align-items-center gap-2">
                <i class="bi bi-collection-fill text-teal"></i>
                <span>Available: <strong class="text-primary">@(Model?.TotalRecords ?? Model?.TemplateList?.Count ?? 0)</strong> Templates</span>
            </div>

            <a asp-controller="AiBanner" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-stars me-1"></i> AI Banner Studio
            </a>

            <a asp-controller="Design" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-folder2-open me-1"></i> My Saved Designs
            </a>
        </div>
    </div>

    <!-- ── CATEGORY PILLS BAR ── -->
    <div class="d-flex align-items-center gap-2 pb-3 mb-3 overflow-auto flex-nowrap" style="scrollbar-width: thin;">
        <a asp-action="Index" asp-route-orientation="@activeOrientation" asp-route-searchKey="@Model?.SearchKey"
           class="btn btn-sm rounded-pill px-3 py-2 text-nowrap fw-medium @(string.IsNullOrEmpty(activeCategory) ? "btn-primary shadow-sm" : "btn-light border text-dark")">
            <i class="bi bi-stars me-1"></i> All Templates
        </a>

        @if (Model?.CategoryList != null)
        {
            foreach (var cat in Model.CategoryList)
            {
                var isSelected = (Model?.CategoryId.HasValue == true && Model.CategoryId.Value == cat.CategoryId);
                var icon = cat.Slug?.Contains("cardio") == true ? "heart-pulse-fill" :
                           cat.Slug?.Contains("diabetes") == true ? "droplet-half" :
                           cat.Slug?.Contains("pediatric") == true ? "balloon-fill" :
                           cat.Slug?.Contains("festival") == true ? "stars" :
                           cat.Slug?.Contains("aware") == true ? "shield-exclamation" :
                           cat.Slug?.Contains("announce") == true ? "megaphone-fill" :
                           cat.Slug?.Contains("promot") == true ? "tag-fill" : "hospital-fill";

                <a asp-action="Index" asp-route-categoryId="@cat.CategoryId" asp-route-orientation="@activeOrientation" asp-route-searchKey="@Model?.SearchKey"
                   class="btn btn-sm rounded-pill px-3 py-2 text-nowrap fw-medium @(isSelected ? "btn-primary shadow-sm" : "btn-light border text-dark")">
                    <i class="bi bi-@icon me-1 text-teal"></i> @cat.CategoryName
                </a>
            }
        }
    </div>

    <!-- ── SEARCH & FILTER CONTROLS ── -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <!-- Search input -->
                <div class="col-lg-4 col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchKey" value="@Model?.SearchKey" class="form-control border-start-0 ps-0" placeholder="Search templates by disease, topic, or keyword..." />
                    </div>
                </div>

                <!-- Category dropdown -->
                <div class="col-lg-3 col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-tag"></i></span>
                        <select name="categoryId" class="form-select border-start-0 ps-0">
                            <option value="">All Categories</option>
                            @if (Model?.CategoryList != null)
                            {
                                foreach (var c in Model.CategoryList)
                                {
                                    <option value="@c.CategoryId" selected="@(Model.CategoryId == c.CategoryId)">@c.CategoryName</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <!-- Orientation dropdown -->
                <div class="col-lg-3 col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-aspect-ratio"></i></span>
                        <select name="orientation" class="form-select border-start-0 ps-0">
                            <option value="">All Orientations</option>
                            <option value="Square" selected="@(Model?.Orientation == "Square")">Square (1:1 Feed)</option>
                            <option value="Portrait" selected="@(Model?.Orientation == "Portrait")">Portrait / Story (9:16)</option>
                            <option value="Landscape" selected="@(Model?.Orientation == "Landscape")">Landscape (16:9 Banner)</option>
                        </select>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="col-lg-2 col-md-6 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-3 flex-grow-1 shadow-sm">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    @if (!string.IsNullOrEmpty(Model?.SearchKey) || Model?.CategoryId.HasValue == true || !string.IsNullOrEmpty(Model?.Orientation))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3" title="Clear Filters">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- ── TEMPLATE GALLERY GRID ── -->
    @if (Model?.TemplateList?.Any() == true)
    {
        <div class="row g-4 mb-4">
            @foreach (var t in Model.TemplateList)
            {
                var isStory = t.Orientation == "Portrait";
                var isBanner = t.Orientation == "Landscape";
                var aspectStyle = isStory ? "aspect-ratio: 9/16; max-height: 420px;" :
                                  isBanner ? "aspect-ratio: 16/9;" : "aspect-ratio: 1/1;";
                var badgeColor = isStory ? "warning" : isBanner ? "info" : "primary";

                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden template-card-item transition-all position-relative" style="transition: transform 0.2s, box-shadow 0.2s;">

                        <!-- Thumbnail & Badges Container -->
                        <div class="position-relative overflow-hidden bg-light d-flex align-items-center justify-content-center" style="@aspectStyle">
                            @if (!string.IsNullOrEmpty(t.ThumbnailPath))
                            {
                                <img src="@t.ThumbnailPath" alt="@t.TemplateName" class="w-100 h-100 template-thumb-img" style="object-fit: cover;" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center text-white p-3 text-center"
                                     style="background: linear-gradient(135deg, #1B2B6B 0%, #0EA5A0 100%);">
                                    <i class="bi bi-heart-pulse-fill fs-1 opacity-75 mb-2"></i>
                                    <span class="fw-bold fs-6">@t.TemplateName</span>
                                    <small class="opacity-75">@t.CategoryName</small>
                                </div>
                            }

                            <!-- Orientation Badge -->
                            <div class="position-absolute top-0 start-0 m-2">
                                <span class="badge bg-dark bg-opacity-75 backdrop-blur text-white px-2 py-1 rounded-pill small" style="font-size: 10px;">
                                    <i class="bi bi-aspect-ratio me-1"></i>@(t.Orientation ?? "Square")
                                </span>
                            </div>

                            <!-- PRO Badge -->
                            @if (t.IsPremium)
                            {
                                <div class="position-absolute top-0 end-0 m-2">
                                    <span class="badge bg-warning text-dark px-2 py-1 rounded-pill fw-bold shadow-sm" style="font-size: 10px;">
                                        <i class="bi bi-star-fill me-1"></i>PRO
                                    </span>
                                </div>
                            }

                            <!-- Hover Overlay with Actions -->
                            <div class="template-hover-overlay position-absolute inset-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center gap-2 p-3 opacity-0"
                                 style="background: rgba(15, 26, 66, 0.85); transition: opacity 0.25s ease; backdrop-filter: blur(2px);">
                                
                                <button type="button" class="btn btn-light btn-sm rounded-pill px-3 shadow fw-semibold"
                                        onclick="openQuickPreview('@t.TemplateName', '@(t.ThumbnailPath ?? "")', '@(t.CategoryName ?? "General")', '@(t.Orientation ?? "Square")', '@(t.WidthPx)x@(t.HeightPx)', '@t.EncId', '@(t.Description ?? "")')">
                                    <i class="bi bi-eye-fill me-1 text-primary"></i> Quick Preview
                                </button>

                                <form asp-action="UseTemplate" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="templateId" value="@(t.EncId ?? t.TemplateId.ToString())" />
                                    <button type="submit" class="btn btn-teal btn-sm rounded-pill px-3 shadow fw-semibold text-white" style="background:#0EA5A0;">
                                        <i class="bi bi-pencil-square me-1"></i> Customize in Editor
                                    </button>
                                </form>

                                <a asp-controller="AiBanner" asp-action="Index" asp-route-topic="@t.TemplateName" class="btn btn-outline-light btn-sm rounded-pill px-3 fw-medium">
                                    <i class="bi bi-stars me-1 text-warning"></i> Generate with AI
                                </a>
                            </div>
                        </div>

                        <!-- Card Body Details -->
                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" style="font-size: 11px;">
                                        @(t.CategoryName ?? "Clinical Care")
                                    </span>
                                    <small class="text-muted" style="font-size: 11px;">
                                        <i class="bi bi-eye me-1"></i>@(t.UsageCount) uses
                                    </small>
                                </div>

                                <h6 class="fw-bold text-dark mb-1 text-truncate" title="@t.TemplateName">@t.TemplateName</h6>
                                <p class="text-muted small mb-3 text-truncate-2" style="font-size: 12px; min-height: 36px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @(string.IsNullOrWhiteSpace(t.Description) ? "Professional medical awareness poster ready for clinical branding." : t.Description)
                                </p>
                            </div>

                            <!-- Bottom Action Row -->
                            <div class="d-flex align-items-center gap-2 pt-2 border-top">
                                <a asp-action="Preview" asp-route-id="@(t.EncId ?? t.TemplateId.ToString())" class="btn btn-outline-secondary btn-sm rounded-pill flex-grow-1" style="font-size: 12px;">
                                    <i class="bi bi-eye me-1"></i> Preview
                                </a>

                                <form asp-action="UseTemplate" method="post" class="flex-grow-1 m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="templateId" value="@(t.EncId ?? t.TemplateId.ToString())" />
                                    <button type="submit" class="btn btn-primary btn-sm rounded-pill w-100 shadow-sm" style="font-size: 12px;">
                                        <i class="bi bi-pencil me-1"></i> Use
                                    </button>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>

        <!-- ── PAGINATION ── -->
        @if (Model.TotalPages > 1)
        {
            <nav class="my-4">
                <ul class="pagination justify-content-center gap-1 mb-0">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        var isActive = (i == Model.PageNo);
                        <li class="page-item @(isActive ? "active" : "")">
                            <a class="page-link rounded-pill px-3 @(isActive ? "btn-primary text-white" : "border text-dark bg-white")"
                               asp-action="Index"
                               asp-route-pageNo="@i"
                               asp-route-searchKey="@Model.SearchKey"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-orientation="@Model.Orientation">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <!-- ── EMPTY STATE ── -->
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4">
            <div class="py-4">
                <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-search fs-1"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">No Templates Found</h5>
                <p class="text-muted small mb-4" style="max-width: 480px; margin: 0 auto;">
                    We couldn't find any medical templates matching your selected filter. Try clearing filters or create a custom banner with AI.
                </p>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-x-circle me-1"></i> Reset All Filters
                    </a>
                    <a asp-controller="AiBanner" asp-action="Index" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-stars me-1"></i> Generate with AI
                    </a>
                </div>
            </div>
        </div>
    }

</div>

<!-- ── QUICK PREVIEW MODAL ── -->
<div class="modal fade" id="quickPreviewModal" tabindex="-1" aria-labelledby="quickPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom px-4 py-3 bg-light">
                <div>
                    <h5 class="modal-title fw-bold text-dark" id="modalTemplateName">Template Preview</h5>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <span class="badge bg-primary-subtle text-primary border rounded-pill" id="modalCategoryBadge">Category</span>
                        <span class="badge bg-dark bg-opacity-75 text-white rounded-pill" id="modalOrientationBadge">1:1 Square</span>
                        <span class="badge bg-light text-muted border rounded-pill" id="modalDimensionsBadge">1080 × 1080 px</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center bg-dark bg-opacity-10 d-flex align-items-center justify-content-center" style="min-height: 420px;">
                <img id="modalPreviewImg" src="" alt="Template" class="img-fluid rounded-3 shadow-sm" style="max-height: 520px; object-fit: contain;" />
            </div>
            <div class="modal-footer border-top px-4 py-3 bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <p class="text-muted small mb-0 text-start" id="modalDescription" style="max-width: 400px; font-size: 12px;"></p>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Close</button>
                    <form asp-action="UseTemplate" method="post" id="modalUseForm" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="templateId" id="modalTemplateIdInput" value="" />
                        <button type="submit" class="btn btn-primary rounded-pill px-4 btn-sm shadow-sm">
                            <i class="bi bi-pencil-square me-1"></i> Use In Banner Editor
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<style>
    .template-card-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(15, 26, 66, 0.12) !important;
    }
    .template-card-item:hover .template-hover-overlay {
        opacity: 1 !important;
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
<script>
    function openQuickPreview(name, imgPath, catName, orientation, dims, encId, desc) {
        document.getElementById('modalTemplateName').textContent = name;
        document.getElementById('modalCategoryBadge').textContent = catName;
        document.getElementById('modalOrientationBadge').textContent = orientation;
        document.getElementById('modalDimensionsBadge').textContent = dims + ' px';
        document.getElementById('modalPreviewImg').src = imgPath;
        document.getElementById('modalTemplateIdInput').value = encId;
        document.getElementById('modalDescription').textContent = desc || 'Clinically ready medical template for social posts.';
        
        const modal = new bootstrap.Modal(document.getElementById('quickPreviewModal'));
        modal.show();
    }
</script>
}
