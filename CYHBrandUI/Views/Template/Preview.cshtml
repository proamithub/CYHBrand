@model CYHBrandModel.DTO.BannerTemplateDTO
@{
    ViewData["Title"] = "Template Preview: " + Model?.TemplateName;
    var isStory = Model?.Orientation == "Portrait";
    var isBanner = Model?.Orientation == "Landscape";
}

<div class="container-fluid px-3 px-md-4 py-3">

    <!-- ── TOP HEADER & BREADCRUMB ── -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Template" asp-action="Index" class="text-decoration-none text-muted">Template Library</a></li>
                    <li class="breadcrumb-item active text-primary fw-medium" aria-current="page">Preview</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-eye-fill text-primary"></i> @(Model?.TemplateName ?? "Template Preview")
            </h3>
            <p class="text-muted small mb-0 mt-1">Review layout structure, dimensions, and typography before customizing in the editor.</p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Templates
            </a>

            <form asp-action="UseTemplate" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="templateId" value="@(Model?.EncId ?? Model?.TemplateId.ToString())" />
                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm">
                    <i class="bi bi-pencil-square me-1"></i> Use In Banner Editor
                </button>
            </form>
        </div>
    </div>

    <!-- ── PREVIEW CONTENT ROW ── -->
    <div class="row g-4">
        <!-- Left: Image Canvas Preview -->
        <div class="col-lg-7 col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 pt-3 px-4 pb-0 d-flex align-items-center justify-content-between">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill small">
                        @(Model?.CategoryName ?? "Medical Template")
                    </span>
                    <span class="badge bg-light text-muted border px-2 py-1 rounded-pill small">
                        <i class="bi bi-aspect-ratio me-1"></i>@(Model?.Orientation) (@(Model?.WidthPx) × @(Model?.HeightPx) px)
                    </span>
                </div>
                <div class="card-body p-4 d-flex align-items-center justify-content-center bg-dark bg-opacity-10" style="min-height: 480px;">
                    @if (!string.IsNullOrEmpty(Model?.ThumbnailPath))
                    {
                        <img src="@Model.ThumbnailPath" class="img-fluid rounded-3 shadow" style="max-height: 600px; object-fit: contain;" alt="@Model.TemplateName" />
                    }
                    else
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center rounded-3 p-5 text-white"
                             style="width: 480px; height: 480px; background: linear-gradient(135deg, #1B2B6B 0%, #0EA5A0 100%);">
                            <i class="bi bi-heart-pulse-fill fs-1 opacity-75 mb-3"></i>
                            <h4 class="fw-bold mb-1 text-center">@Model?.TemplateName</h4>
                            <span class="opacity-75">@Model?.CategoryName</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right: Template Metadata & Quick Actions -->
        <div class="col-lg-5 col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-3">Template Specifications</h5>

                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <span class="text-muted small"><i class="bi bi-tag me-1 text-primary"></i> Category</span>
                            <span class="fw-semibold text-dark">@(Model?.CategoryName ?? "General Clinical")</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <span class="text-muted small"><i class="bi bi-aspect-ratio me-1 text-primary"></i> Orientation</span>
                            <span class="fw-semibold text-dark">@(Model?.Orientation ?? "Square")</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <span class="text-muted small"><i class="bi bi-bounding-box-circles me-1 text-primary"></i> Dimensions</span>
                            <span class="fw-semibold text-dark font-monospace">@(Model?.WidthPx) × @(Model?.HeightPx) px</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <span class="text-muted small"><i class="bi bi-eye me-1 text-primary"></i> Doctor Usage</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">@(Model?.UsageCount) times used</span>
                        </li>
                        @if (!string.IsNullOrEmpty(Model?.Tags))
                        {
                            <li class="list-group-item px-0">
                                <span class="text-muted small d-block mb-1"><i class="bi bi-tags me-1 text-primary"></i> Tags</span>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var tag in Model.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="badge bg-light text-dark border rounded-pill small">#@tag.Trim()</span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>

                    @if (!string.IsNullOrEmpty(Model?.Description))
                    {
                        <div class="p-3 rounded-3 bg-light border mb-4">
                            <h6 class="fw-semibold text-dark small mb-1">Clinical Context & Advice</h6>
                            <p class="text-muted small mb-0" style="font-size: 13px;">@Model.Description</p>
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <form asp-action="UseTemplate" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="templateId" value="@(Model?.EncId ?? Model?.TemplateId.ToString())" />
                            <button type="submit" class="btn btn-primary rounded-pill py-2 w-100 shadow-sm fw-semibold">
                                <i class="bi bi-pencil-square me-1"></i> Customize In Banner Editor
                            </button>
                        </form>

                        <a asp-controller="AiBanner" asp-action="Index" asp-route-topic="@Model?.TemplateName" class="btn btn-outline-primary rounded-pill py-2 w-100 fw-semibold">
                            <i class="bi bi-stars me-1 text-warning"></i> Generate AI Banner on This Topic
                        </a>
                    </div>
                </div>
            </div>

            <!-- Best Practice Guidelines -->
            <div class="card border-0 shadow-sm rounded-4 bg-primary-subtle border-primary-subtle">
                <div class="card-body p-3 d-flex align-items-start gap-2">
                    <i class="bi bi-info-circle-fill text-primary fs-5 mt-1"></i>
                    <div class="small">
                        <strong class="text-primary">Automated Doctor Branding:</strong>
                        <span class="text-dark d-block mt-1">
                            Opening this template in the editor automatically attaches your doctor photo, qualifications, and clinic address ribbon at the bottom.
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
