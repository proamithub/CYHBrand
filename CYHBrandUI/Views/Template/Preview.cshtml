@model CYHBrandModel.DTO.BannerTemplateDTO
@{
    ViewData["Title"] = "Preview: " + Model?.TemplateName;
}

<div class="p-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back
        </a>
        <h4 class="fw-bold mb-0">@Model?.TemplateName</h4>
        @if (Model?.IsPremium == true)
        {
            <span class="badge bg-warning text-dark">PRO</span>
        }
    </div>

    <div class="row g-4">
        <div class="col-md-7">
            <!-- Template Preview -->
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-center p-5">
                    @if (!string.IsNullOrEmpty(Model?.ThumbnailPath))
                    {
                        <img src="@Model.ThumbnailPath" class="img-fluid rounded" style="max-height:500px"
                             alt="@Model.TemplateName" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center rounded"
                             style="width:400px;height:400px;background:linear-gradient(135deg,#667eea,#764ba2)">
                            <span class="text-white fw-bold fs-5">@Model?.TemplateName</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-semibold mb-3">Template Details</h6>
                    <dl class="row small">
                        <dt class="col-5 text-muted">Category</dt>
                        <dd class="col-7">@(Model?.CategoryName ?? "—")</dd>

                        <dt class="col-5 text-muted">Orientation</dt>
                        <dd class="col-7">@(Model?.Orientation ?? "—")</dd>

                        <dt class="col-5 text-muted">Size</dt>
                        <dd class="col-7">@Model?.WidthPx × @Model?.HeightPx px</dd>

                        <dt class="col-5 text-muted">Usage Count</dt>
                        <dd class="col-7">@Model?.UsageCount times</dd>

                        <dt class="col-5 text-muted">Tags</dt>
                        <dd class="col-7">@(Model?.Tags ?? "—")</dd>
                    </dl>

                    @if (!string.IsNullOrEmpty(Model?.Description))
                    {
                        <hr />
                        <p class="text-muted small">@Model.Description</p>
                    }

                    <hr />
                    <form asp-action="UseTemplate" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="templateId" value="@Model?.TemplateId" />
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-pencil-square me-1"></i> Use This Template
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
