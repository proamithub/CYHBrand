@model CYHBrandModel.DTO.DoctorMasterDTO
@{
    ViewData["Title"] = "Dashboard";
    var user = ViewBag.CurrentUser as CYHBrandUI.Helpers.CustomPrincipal;
}

<div class="p-4">
    <!-- Welcome Row -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="mb-0 fw-bold">Welcome back, <span class="text-primary">@(Model?.DisplayName ?? Model?.FullName ?? "Doctor")</span> 👋</h4>
            <p class="text-muted mb-0">Here's what's happening with your brand today.</p>
        </div>
        <a asp-controller="Design" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> New Design
        </a>
    </div>

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-grid"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">0</div>
                    <div class="text-muted small">Total Designs</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card d-flex align-items-center gap-3">
                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">0</div>
                    <div class="text-muted small">Published</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card d-flex align-items-center gap-3">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-clock"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">0</div>
                    <div class="text-muted small">Scheduled</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card d-flex align-items-center gap-3">
                <div class="stat-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-layout-wtf"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">0</div>
                    <div class="text-muted small">Templates Used</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-semibold mb-3">Quick Actions</h6>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Design" asp-action="Create" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-plus me-1"></i> Create Design
                        </a>
                        <a asp-controller="Template" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-layout-wtf me-1"></i> Browse Templates
                        </a>
                        <a asp-controller="Doctor" asp-action="Profile" class="btn btn-outline-info btn-sm">
                            <i class="bi bi-person me-1"></i> My Profile
                        </a>
                        <a asp-controller="Doctor" asp-action="EditProfile" class="btn btn-outline-warning btn-sm">
                            <i class="bi bi-palette me-1"></i> Brand Settings
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Designs placeholder -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
            <h6 class="fw-semibold mb-0">Recent Designs</h6>
            <a asp-controller="Design" asp-action="Index" class="btn btn-sm btn-link">View All</a>
        </div>
        <div class="card-body">
            <div class="text-center py-5 text-muted">
                <i class="bi bi-images display-4 d-block mb-2"></i>
                <p>No designs yet. <a asp-controller="Design" asp-action="Create">Create your first one!</a></p>
            </div>
        </div>
    </div>
</div>
