@model CYHBrandModel.DTO.DashboardDTO
@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageSubtitle"] = "Here's what's happening with your brand today.";
    var doctorName = ViewBag.DoctorName as string ?? "Doctor";
    var now = DateTime.Now;
    var greeting = now.Hour < 12 ? "Good Morning" : now.Hour < 17 ? "Good Afternoon" : "Good Evening";
}

<div>
    <!-- ── Welcome Row ── -->
    <div class="d-flex align-items-start justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h4 class="fw-bold mb-1" style="font-size:1.25rem;">
                @greeting, <span style="color:#0EA5A0;">Dr. @doctorName</span> 👋
            </h4>
            <p class="mb-0" style="color:#64748B;font-size:.875rem;">
                @now.ToString("dddd, dd MMM yyyy")
            </p>
        </div>
        <a asp-controller="Design" asp-action="Create" class="btn btn-cyh-teal d-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i> New Design
        </a>
    </div>

    <!-- ── Stat Cards ── -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="cyh-stat-card">
                <div class="cyh-stat-icon" style="background:#EFF6FF;">
                    <i class="bi bi-grid" style="color:#3B82F6;"></i>
                </div>
                <div>
                    <div class="cyh-stat-value">@(Model?.TotalDesigns ?? 0)</div>
                    <div class="cyh-stat-label">Total Designs</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="cyh-stat-card">
                <div class="cyh-stat-icon" style="background:#F0FDF4;">
                    <i class="bi bi-calendar-check" style="color:#10B981;"></i>
                </div>
                <div>
                    <div class="cyh-stat-value">@(Model?.ScheduledPosts ?? 0)</div>
                    <div class="cyh-stat-label">Scheduled Posts</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="cyh-stat-card">
                <div class="cyh-stat-icon" style="background:#FFF7ED;">
                    <i class="bi bi-share" style="color:#F59E0B;"></i>
                </div>
                <div>
                    <div class="cyh-stat-value">@(Model?.TotalShares ?? 0)</div>
                    <div class="cyh-stat-label">Total Shares</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="cyh-stat-card">
                <div class="cyh-stat-icon" style="background:rgba(14,165,160,.1);">
                    <i class="bi bi-people" style="color:#0EA5A0;"></i>
                </div>
                <div>
                    <div class="cyh-stat-value">@(Model?.SocialReach > 0 ? (Model.SocialReach >= 1000 ? $"{Model.SocialReach/1000.0:0.#}K" : Model.SocialReach.ToString()) : "0")</div>
                    <div class="cyh-stat-label">Social Reach</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <!-- ── Quick Actions ── -->
        <div class="col-lg-6">
            <div class="cyh-card h-100">
                <div class="cyh-card-header">
                    <h6 class="cyh-card-title">Quick Actions</h6>
                </div>
                <div class="cyh-card-body">
                    <div class="row g-2">
                        <div class="col-4">
                            <a asp-controller="AiBanner" asp-action="Index" class="cyh-quick-card text-decoration-none">
                                <div class="cyh-quick-icon" style="background:#EFF6FF;">
                                    <i class="bi bi-stars" style="color:#3B82F6;font-size:1.4rem;"></i>
                                </div>
                                <div class="cyh-quick-label">AI Banner Maker</div>
                                <div class="cyh-quick-desc">Create a new design with AI</div>
                            </a>
                        </div>
                        <div class="col-4">
                            <a asp-controller="Template" asp-action="Index" class="cyh-quick-card text-decoration-none">
                                <div class="cyh-quick-icon" style="background:rgba(14,165,160,.1);">
                                    <i class="bi bi-grid-1x2" style="color:#0EA5A0;font-size:1.4rem;"></i>
                                </div>
                                <div class="cyh-quick-label">Templates</div>
                                <div class="cyh-quick-desc">Choose from ready-made templates</div>
                            </a>
                        </div>
                        <div class="col-4">
                            <a asp-controller="Calendar" asp-action="Index" class="cyh-quick-card text-decoration-none">
                                <div class="cyh-quick-icon" style="background:#FFF7ED;">
                                    <i class="bi bi-calendar-plus" style="color:#F59E0B;font-size:1.4rem;"></i>
                                </div>
                                <div class="cyh-quick-label">Schedule Post</div>
                                <div class="cyh-quick-desc">Plan your content for later</div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Today's Content ── -->
        <div class="col-lg-6">
            <div class="cyh-card h-100">
                <div class="cyh-card-header">
                    <h6 class="cyh-card-title">Today's Content</h6>
                    <span class="cyh-badge cyh-badge-teal">Live</span>
                </div>
                <div class="cyh-card-body">
                    @if (Model?.TodaysDesigns?.Any() == true)
                    {
                        @foreach (var d in Model.TodaysDesigns.Take(2))
                        {
                            var todayThumb = !string.IsNullOrWhiteSpace(d.ThumbnailPath)
                                ? (d.ThumbnailPath.StartsWith("data:") || d.ThumbnailPath.StartsWith("http") ? d.ThumbnailPath : "/" + d.ThumbnailPath.TrimStart('/'))
                                : "";
                            <div class="cyh-design-row">
                                <div class="cyh-design-row-thumb">
                                    @if (!string.IsNullOrEmpty(todayThumb))
                                    {
                                        <img src="@todayThumb" alt="" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-image"></i>
                                    }
                                </div>
                                <div class="cyh-design-row-info">
                                    <div class="cyh-design-row-name">@d.DesignName</div>
                                    <div class="cyh-design-row-meta">@d.CategoryName · @d.CreatedAt.ToString("h:mm tt")</div>
                                </div>
                                <span class="cyh-badge @(d.StatusId == 2 ? "cyh-badge-teal" : "cyh-badge-secondary")">
                                    @(d.StatusId == 2 ? "Published" : "Draft")
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="cyh-empty py-3">
                            <span class="cyh-empty-icon" style="font-size:2rem;"><i class="bi bi-calendar-x"></i></span>
                            <div class="cyh-empty-title">No content today</div>
                            <div class="cyh-empty-desc mt-1">
                                <a asp-controller="Design" asp-action="Create" style="color:#0EA5A0;">Create a design</a> to get started
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ── Recent Designs ── -->
    <div class="cyh-card">
        <div class="cyh-card-header">
            <h6 class="cyh-card-title">Recent Designs</h6>
            <a asp-controller="Design" asp-action="Index" class="btn btn-cyh-outline btn-sm">View All</a>
        </div>
        <div class="cyh-card-body">
            @if (Model?.RecentDesigns?.Any() == true)
            {
                <div class="row g-3">
                    @foreach (var d in Model.RecentDesigns.Take(4))
                    {
                        var recentThumb = !string.IsNullOrWhiteSpace(d.ThumbnailPath)
                            ? (d.ThumbnailPath.StartsWith("data:") || d.ThumbnailPath.StartsWith("http") ? d.ThumbnailPath : "/" + d.ThumbnailPath.TrimStart('/'))
                            : "";
                        <div class="col-sm-6 col-lg-3">
                            <div class="cyh-banner-card">
                                <div class="cyh-banner-thumb">
                                    @if (!string.IsNullOrEmpty(recentThumb))
                                    {
                                        <img src="@recentThumb" alt="@d.DesignName" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-image"></i>
                                    }
                                </div>
                                <div class="cyh-banner-body">
                                    <div class="cyh-banner-title">@d.DesignName</div>
                                    <div class="cyh-banner-meta">@d.CreatedAt.ToString("dd MMM yyyy")</div>
                                </div>
                                <div class="cyh-banner-actions">
                                    <a asp-controller="Design" asp-action="Edit" asp-route-id="@d.DesignId"
                                       class="btn btn-sm btn-cyh-outline flex-fill" style="font-size:.75rem;padding:5px;">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <a asp-controller="Design" asp-action="Detail" asp-route-id="@d.DesignId"
                                       class="btn btn-sm btn-cyh-outline flex-fill" style="font-size:.75rem;padding:5px;">
                                        <i class="bi bi-eye me-1"></i>Preview
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="cyh-empty">
                    <span class="cyh-empty-icon"><i class="bi bi-images"></i></span>
                    <div class="cyh-empty-title">No designs yet</div>
                    <div class="cyh-empty-desc mt-2">
                        <a asp-controller="Design" asp-action="Create" class="btn btn-cyh-teal btn-sm mt-2">
                            <i class="bi bi-plus me-1"></i>Create Your First Design
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
